# any string to be used as a secret key to sign x-token
REFINANCE_SECRET_KEY=0000-1111-2222-3333-4444-5555

# secret used to authorize POS endpoints (x-pos-secret header)
REFINANCE_POS_SECRET=change-me-pos-secret

# telegram bot that will send users a link to login
REFINANCE_TELEGRAM_BOT_API_TOKEN=0000000:abcdef0123456789

# web ui url (used for constructing auth links)
# dev suggestion: http://localhost:9000
REFINANCE_UI_URL=http://localhost:9000

# web ui secret key for Flask session signing
REFINANCE_UI_SECRET_KEY=change-me

# public api url (needed for deposit provider callbacks)
# dev : http://localhost:8000
REFINANCE_API_URL=http://refinance.f0rth.space

# cryptapi deposit provider credentials (optional in dev)
REFINANCE_CRYPTAPI_ADDRESS_ERC20_USDT=0xxxxxxxxxxxxx
REFINANCE_CRYPTAPI_ADDRESS_TRC20_USDT=Txxxxxxxxxxxxx

# stripe deposit provider credentials
REFINANCE_STRIPE_SECRET_KEY=
REFINANCE_STRIPE_WEBHOOK_SECRET=
REFINANCE_STRIPE_SUCCESS_URL=
REFINANCE_STRIPE_CANCEL_URL=
REFINANCE_STRIPE_POLL_INTERVAL_SECONDS=60
REFINANCE_STRIPE_AUTHORIZATION_MAX_CONSECUTIVE_ERRORS=3
REFINANCE_STRIPE_ENTITY_CHARGE_ENABLED=true
REFINANCE_STRIPE_ENTITY_CHARGE_DAY=1
REFINANCE_STRIPE_ENTITY_CHARGE_HOUR=12
REFINANCE_STRIPE_ENTITY_CHARGE_MINUTE=15
REFINANCE_STRIPE_GUEST_CHARGE_ENABLED=true
REFINANCE_STRIPE_GUEST_CHARGE_DAY=1
REFINANCE_STRIPE_GUEST_CHARGE_HOUR=10
REFINANCE_STRIPE_GUEST_CHARGE_MINUTE=0

# database connection (defaults to Postgres service named "db")
REFINANCE_DATABASE_URL=postgresql://postgres:postgres@db:5432/refinance


# fee presets (tag-based amounts) as JSON list
# example: resident tag id=2, member tag id=14
REFINANCE_FEE_PRESETS=[{"tag_id":2,"currency":"usd","amount":"42"},{"tag_id":2,"currency":"gel","amount":"115"},{"tag_id":14,"currency":"usd","amount":"25"},{"tag_id":14,"currency":"gel","amount":"70"}]

REFINANCE_DONATION_NOTIFICATION_CHAT_ID=
REFINANCE_DONATION_NOTIFICATION_TOPIC_ID=

# donation page limits (GEL)
REFINANCE_DONATION_MIN_AMOUNT=1
REFINANCE_DONATION_MAX_AMOUNT=3000
