{% extends "base.jinja2" %}
{% from "transaction/macro_list.jinja2" import transaction_list with context %}
{% from "invoice/macro_list.jinja2" import invoice_list with context %}
{% from 'widgets/tag_inline.jinja2' import tag_inline %}
{% from 'widgets/pagination.jinja2' import pagination_control %}
{% from 'widgets/history_stats.jinja2' import history_stats, stats_loader with context %}

{% block title %}{{ entity.name }}{% endblock %}

{% block heading %}{% endblock %}

{% block content %}
<div class="entity-dashboard">
    <section class="entity-hero-card">
        <div class="entity-hero-top">
            <div>
                <p class="entity-kicker entity-kicker-single-line">
                    Created {{ human_readable_date(entity.created_at) }}
                    {% if entity.modified_at %}
                    <span class="entity-kicker-dot">•</span>
                    Modified {{ human_readable_date(entity.modified_at) }}
                    {% endif %}
                </p>
                <div class="entity-identity-row">
                    <h2 class="entity-hero-title">
                        <span class="{% if not entity.active %}secondary inactive{% endif %}">{{ entity.name }}</span>
                    </h2>
                    <div class="entity-tags entity-tags-inline">
                        {% if entity.tags %}
                        {% for tag in entity.tags %}
                        {{ tag_inline(tag) }}
                        {% endfor %}
                        {% else %}
                        <span class="entity-empty-pill">No tags</span>
                        {% endif %}
                    </div>
                </div>
                <div class="entity-hero-meta">
                    <span class="entity-chip">ID #{{ entity.id }}</span>
                    <span
                        class="entity-chip {% if entity.active %}entity-chip-ok{% else %}entity-chip-warning{% endif %}">
                        {{ "Active" if entity.active else "Inactive" }}
                    </span>
                    <span class="entity-chip">{{ total }} transactions</span>
                    <span class="entity-chip">{{ invoices_total }} invoices</span>
                </div>
            </div>
            <div class="entity-hero-actions">
                <a href="{{ url_for('entity.edit', id=entity.id) }}"
                    class="big-button big-button-inline big-button-outline entity-edit-button">Edit</a>
            </div>
        </div>
        {% if entity.comment %}
        <p class="entity-comment">
            {{ entity.comment }}
        </p>
        {% endif %}
    </section>

    <div class="entity-main-grid">
        <div class="entity-left-rail">
            <section class="entity-card entity-balance-card">
                <div class="entity-card-header entity-card-header-tight">
                    <h3 class="entity-card-title">Balance</h3>
                    <a href="{{ url_for('exchange.index') }}"
                        class="big-button big-button-inline entity-draft-find-button">
                        Exchange
                    </a>
                </div>
                {% if balance.completed or balance.draft %}
                {%- set ns = namespace(completed_has_neg=false, draft_has_neg=false) -%}
                {%- for currency, amount in balance.completed.items() -%}
                {%- if amount|float < 0 -%}{%- set ns.completed_has_neg=true -%}{%- endif -%} {%- endfor -%} {%- if
                    balance.draft -%} {%- for currency, amount in balance.draft.items() -%} {%- if amount|float < 0
                    -%}{%- set ns.draft_has_neg=true -%}{%- endif -%} {%- endfor -%} {%- endif -%} <div
                    class="entity-balance-list">
                    {% for currency,amount in balance.completed.items() %}
                    <div class="entity-balance-row">
                        {% if ns.completed_has_neg %}<span class="entity-balance-warning">{% if amount|float < 0 %}⚠️{%
                                endif %}</span>{% endif %}
                                <strong class="entity-balance-amount right-align">{{ amount }}</strong>
                                <span class="entity-balance-currency">{{ currency | upper }}</span>
                    </div>
                    {% endfor %}
                    {% if balance.draft %}
                    <div class="entity-balance-separator">
                        <span>Draft</span>
                        <a href="{{ url_for('transaction.list', entity_id=entity.id, status='draft') }}"
                            class="big-button big-button-inline big-button-outline entity-draft-find-button">
                            Find
                        </a>
                    </div>
                    {% for currency,amount in balance.draft.items() %}
                    <div class="entity-balance-row entity-balance-row-draft">
                        <strong class="entity-balance-amount right-align">{{ amount }}</strong>
                        <span class="entity-balance-currency">{{ currency | upper }}</span>
                    </div>
                    {% endfor %}
                    {% endif %}
        </div>
        {% else %}
        <p class="entity-empty-state">No transactions yet.</p>
        {% endif %}
        </section>

        <section class="entity-card">
            <h3 class="entity-card-title">Invoices{% if invoices_unpaid_count > 0 %} <span
                    class="entity-invoice-count">({{ invoices_unpaid_count }} unpaid)</span>{% endif %}</h3>
            {% if invoices %}
            <ul class="entity-invoice-compact-list">
                {% for invoice in invoices[:6] %}
                <li class="entity-invoice-compact-item">
                    <a href="{{ url_for('invoice.detail', id=invoice.id) }}"
                        class="entity-invoice-compact-link {% if invoice.status == 'paid' %}entity-invoice-compact-link-paid{% endif %}">
                        <span class="entity-invoice-compact-amount">
                            {% if invoice.paid_amount is not none and invoice.paid_currency %}
                            {{ invoice.paid_amount }} {{ invoice.paid_currency }}
                            {% else %}
                            {% for currency, amount in invoice.display_amounts %}
                            {{ "%.2f"|format(amount|float) }} {{ currency | upper }}{% if not loop.last %} / {% endif %}
                            {% else %}Amount unavailable{% endfor %}
                            {% endif %}
                        </span>
                        <span class="entity-invoice-compact-meta">
                            #{{ invoice.id }} • {% if invoice.billing_period %}{{
                            format_billing_period(invoice.billing_period) }}{% else %}{{
                            human_readable_date(invoice.created_at) }}{% endif %} • {{ invoice.status }}
                        </span>
                    </a>
                </li>
                {% endfor %}
            </ul>
            <p class="entity-invoice-compact-note"><strong>Top up your balance!</strong> Invoices are paid
                automatically.</p>
            {% if invoices_total > 6 %}
            <p class="entity-invoice-compact-note">Showing 6 of {{ invoices_total }} invoices.</p>
            {% endif %}
            {% else %}
            <p class="entity-empty-state">No invoices.</p>
            {% endif %}
        </section>

        {% if stripe_configured and g.actor_entity and g.actor_entity.id == entity.id %}
        <section class="entity-card entity-stripe-card">
            <h3 class="entity-card-title">Stripe Cards</h3>

            <div class="entity-stripe-compact-list">
                <form method="post" class="entity-stripe-add-form">
                    <input type="hidden" name="stripe_action" value="add">
                    <div class="entity-stripe-actions">
                        <button type="submit" class="big-button big-button-inline">Add Card via Stripe</button>
                    </div>
                </form>

                {% if stripe_authorizations %}
                <ul class="entity-stripe-list" id="entity-stripe-list">
                    {% for auth in stripe_authorizations %}
                    <li class="entity-stripe-item {% if not auth.active %}entity-stripe-item-inactive{% endif %}"
                        data-authorization-id="{{ auth.id }}" draggable="true">
                        <div class="entity-stripe-item-top">
                            <div>
                                <div class="entity-stripe-card-line">
                                    <strong>{{ (auth.card_brand or 'card')|upper }} ****{{ auth.card_last4 or '????'
                                        }}</strong>
                                    {% if auth.card_exp_month and auth.card_exp_year %}
                                    <span class="entity-stripe-muted">exp {{ '%02d'|format(auth.card_exp_month) }}/{{
                                        '%02d'|format(auth.card_exp_year % 100) }}</span>
                                    {% endif %}
                                </div>
                                <div class="entity-stripe-muted">
                                    #{{ auth.id }} | {{ 'active' if auth.active else 'inactive' }}
                                    {% if auth.static_amount and auth.static_amount|float > 0 and auth.static_currency
                                    %}
                                    | {{ auth.static_amount }} {{ auth.static_currency }}
                                    {% endif %}
                                </div>
                                {% if auth.consecutive_error_count > 0 %}
                                <div class="entity-stripe-muted {% if auth.active %}entity-stripe-failed{% endif %}">
                                    Failed charges: {{ auth.consecutive_error_count }}
                                </div>
                                {% endif %}
                                <div class="entity-stripe-muted">
                                    Last charge: {% if auth.last_attempt_at %}{{
                                    human_readable_date(auth.last_attempt_at)
                                    }}{% elif auth.last_success_at %}{{ human_readable_date(auth.last_success_at) }}{%
                                    else
                                    %}never{% endif %}
                                </div>
                            </div>
                        </div>

                        {% if auth.last_error %}
                        <div class="entity-stripe-error">Last error: {{ auth.last_error }}</div>
                        {% endif %}

                        <div class="entity-stripe-actions-row">
                            {% if auth.active %}
                            <form method="post">
                                <input type="hidden" name="stripe_action" value="disable">
                                <input type="hidden" name="authorization_id" value="{{ auth.id }}">
                                <button type="submit" class="entity-stripe-action-btn">Disable</button>
                            </form>
                            {% else %}
                            <form method="post">
                                <input type="hidden" name="stripe_action" value="enable">
                                <input type="hidden" name="authorization_id" value="{{ auth.id }}">
                                <button type="submit" class="entity-stripe-action-btn">Enable</button>
                            </form>
                            {% endif %}
                            <form method="post" onsubmit="return confirm('Delete this card authorization?');">
                                <input type="hidden" name="stripe_action" value="delete">
                                <input type="hidden" name="authorization_id" value="{{ auth.id }}">
                                <button type="submit" class="entity-stripe-action-btn entity-stripe-delete-btn"
                                    title="Delete">X</button>
                            </form>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% if stripe_authorizations|length > 1 %}
                <p class="entity-stripe-drag-hint">You can change card priority by drag and drop.</p>
                {% endif %}
                <script>
                    (() => {
                        const list = document.getElementById('entity-stripe-list');
                        if (!list) return;

                        const endpoint = {{ url_for('entity.detail', id = entity.id) | tojson
                    }};
                    let draggingItem = null;

                    const getItems = () => Array.from(list.querySelectorAll('.entity-stripe-item'));

                    const sendPriority = (authorizationId, priority) => {
                        const body = new URLSearchParams();
                        body.set('stripe_action', 'priority');
                        body.set('authorization_id', String(authorizationId));
                        body.set('priority', String(priority));
                        return fetch(endpoint, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            },
                            body: body.toString(),
                            credentials: 'same-origin',
                        });
                    };

                    const persistOrder = async () => {
                        const items = getItems();
                        for (let idx = 0; idx < items.length; idx += 1) {
                            const authId = Number(items[idx].dataset.authorizationId || 0);
                            if (!authId) continue;
                            await sendPriority(authId, idx + 1);
                        }
                        window.location.reload();
                    };

                    const midpointY = (element) => {
                        const rect = element.getBoundingClientRect();
                        return rect.top + (rect.height / 2);
                    };

                    list.addEventListener('dragstart', (event) => {
                        const item = event.target.closest('.entity-stripe-item');
                        if (!item) return;
                        draggingItem = item;
                        item.classList.add('entity-stripe-item-dragging');
                        if (event.dataTransfer) {
                            event.dataTransfer.effectAllowed = 'move';
                            event.dataTransfer.setData('text/plain', item.dataset.authorizationId || '');
                        }
                    });

                    list.addEventListener('dragend', (event) => {
                        const item = event.target.closest('.entity-stripe-item');
                        if (item) item.classList.remove('entity-stripe-item-dragging');
                        draggingItem = null;
                    });

                    list.addEventListener('dragover', (event) => {
                        if (!draggingItem) return;
                        event.preventDefault();
                        const target = event.target.closest('.entity-stripe-item');
                        if (!target || target === draggingItem) return;
                        const before = event.clientY < midpointY(target);
                        if (before) {
                            list.insertBefore(draggingItem, target);
                        } else {
                            list.insertBefore(draggingItem, target.nextSibling);
                        }
                    });

                    list.addEventListener('drop', async (event) => {
                        if (!draggingItem) return;
                        event.preventDefault();
                        await persistOrder();
                    });
                }) ();
                </script>
                {% else %}
                <p class="entity-empty-state">No card authorizations found for this entity.</p>
                {% endif %}
            </div>

        </section>
        {% endif %}
    </div>

    <div class="entity-right-rail">
        <section class="entity-card entity-list-card entity-transactions-card">
            <div class="entity-card-header">
                <h3 class="entity-card-title">Transactions</h3>
                <span class="entity-chip">{{ total }} total</span>
            </div>
            {{ transaction_list(transactions) }}
            {{ pagination_control(page, total, limit) }}
        </section>

        <section class="entity-card entity-stats-card">
            <div class="entity-card-header">
                <h3 class="entity-card-title">Statistics</h3>
            </div>

            {% if not stats_loaded %}
            {{ stats_loader(
                url_for(
                    'entity.stats',
                    id=entity.id,
                    stats_months=stats_months,
                    stats_limit=stats_limit
                ),
                'entity'
            ) }}
            {% else %}
            <div class="stats-controls">
                <span>Top entries:</span>
                {% for limit_option in [5, 8, 12] %}
                <a href="{{ update_query_params(stats_limit=limit_option) }}"
                    class="{% if stats_limit == limit_option %}active{% endif %}">{{ limit_option }}</a>
                {% endfor %}
            </div>
            {% call history_stats(balance_changes, money_flow_by_day, stats_months, 'entity-history') %}
            <div class="chart-cell">
                <h2>Activity Flow: Top Entities (last {{ stats_months }} months)</h2>
                {% if top_incoming or top_outgoing %}
                <div id="entity-sankey-chart" style="min-height:380px;"></div>
                {% else %}
                <p class="chart-placeholder">No entity activity in the selected timeframe.</p>
                {% endif %}
            </div>
            <div class="chart-cell">
                <h2>Activity Flow: Top Tags (last {{ stats_months }} months)</h2>
                {% if top_incoming_tags or top_outgoing_tags %}
                <div id="tag-sankey-chart" style="min-height:380px;"></div>
                {% else %}
                <p class="chart-placeholder">No tagged activity in the selected timeframe.</p>
                {% endif %}
            </div>
            {% endcall %}
            <script src="{{ url_for('static', filename='activity-stats.js') }}"></script>
            <script>
                window.StatsCharts.renderActivityStats({
                    topIncoming: {{ top_incoming | tojson }},
                    topOutgoing: {{ top_outgoing | tojson }},
                    topIncomingTags: {{ top_incoming_tags | tojson }},
                    topOutgoingTags: {{ top_outgoing_tags | tojson }},
                    entityName: {{ entity.name | tojson }},
                });
            </script>
            {% endif %}
        </section>
    </div>

</div>

<script>
    document.querySelectorAll('.transaction-table tr[data-href]').forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (!e.target.closest('a')) {
                window.location.href = row.dataset.href;
            }
        });
    });
</script>
{% endblock %}
