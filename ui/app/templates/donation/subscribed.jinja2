{% extends "donation/base.jinja2" %}

{% block title %}Subscribed — F0RTHSP4CE{% endblock %}

{% block extra_styles %}
.success-body {
margin-top: 4rem;
text-align: center;
}

.success-icon {
font-size: 64px;
line-height: 1;
margin-bottom: 1.5rem;
}

.success-title {
margin: 0 0 1rem;
font-size: clamp(24px, 4vw, 40px);
font-weight: 700;
color: var(--accent);
text-transform: uppercase;
}

.success-text {
margin: 0 0 0.75rem;
font-size: clamp(14px, 2.2vw, 20px);
color: #cccccc;
line-height: 1.5;
}

.success-back {
display: inline-block;
margin-top: 2.5rem;
color: var(--accent);
font-size: clamp(14px, 2.2vw, 20px);
text-decoration: none;
font-weight: 700;
}

.success-back:hover {
text-decoration: underline;
}

.success-portal-btn {
display: inline-block;
margin-top: 1.25rem;
padding: 0.6rem 1.5rem;
border: 2px solid var(--accent);
border-radius: 6px;
color: var(--accent);
font-size: clamp(13px, 2vw, 18px);
font-weight: 600;
text-decoration: none;
}

.success-portal-btn:hover {
background: var(--accent);
color: #000;
}
{% endblock %}

{% block content %}
<div class="success-body">
    <div class="success-icon">✅</div>
    <h2 class="success-title">Subscription active!</h2>
    <p class="success-text">Thank you for your recurring support.</p>
    <p class="success-text">Your card will be charged automatically every month.</p>
    <p class="success-text">A receipt will be sent to your email after each payment.</p>
    {% if portal_url %}
    <br>
    <a class="success-portal-btn" href="{{ portal_url }}" target="_blank" rel="noopener">Manage subscription</a>
    {% endif %}
    <br>
    <a class="success-back" href="{{ url_for('donation.donate') }}">← Back to donations</a>
</div>
{% endblock %}