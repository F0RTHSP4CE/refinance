{% extends "donation/base.jinja2" %}

{% block title %}Thanks — F0RTHSP4CE{% endblock %}

{% block extra_styles %}
.middle {
align-self: center;
}

.line {
margin: 0;
max-width: min(24ch, 100%);
font-size: var(--fs-line);
font-weight: 700;
line-height: 1.42;
letter-spacing: -0.01em;
}

.line b {
color: var(--accent);
font-weight: inherit;
}

.links {
display: flex;
flex-wrap: wrap;
gap: 1.6em 2.4em;
margin-top: 2.4rem;
}

.links a {
font-size: var(--fs-cta);
color: var(--accent);
text-decoration: none;
border-bottom: 2px solid var(--accent);
padding-bottom: 6px;
}

.links a:hover,
.links a:focus-visible {
color: var(--fg);
border-bottom-color: var(--fg);
}
{% endblock %}

{% block content %}
<div class="middle">
    <p class="line">you're <b>in</b>. the card runs every month, receipt by email.</p>
    <div class="links">
        {% if portal_url %}
        <a href="{{ portal_url }}" target="_blank" rel="noopener">manage it</a>
        {% endif %}
        <a href="{{ url_for('donation.donate') }}">give again</a>
    </div>
</div>
{% endblock %}

{% block foot %}
<p class="foot">stripe · cancel any time</p>
{% endblock %}
