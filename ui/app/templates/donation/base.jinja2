<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <title>{% block title %}F0RTHSP4CE{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css"
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --page-bg: #000000;
            --accent: #00ff00;
            --surface-border: #353535;
            --content-width: min(626px, calc(100vw - 48px));
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
            margin: 0;
            background: var(--page-bg);
            color: #ffffff;
        }

        body {
            font-family: "Geist Mono", monospace;
        }

        .donation-page {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 24px;
        }

        .donation-stage {
            width: var(--content-width);
            transform: translateY(-18px);
        }

        .donation-messages {
            margin-bottom: 20px;
            display: grid;
            gap: 10px;
        }

        .donation-message {
            padding: 12px 16px;
            border: 3px solid #ff3b30;
            background: #fff3f2;
            color: #8a140d;
            font-size: 18px;
            line-height: 1.3;
        }

        .donation-brand {
            height: 121px;
            background: #000000;
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 0 36px;
        }

        .donation-brand-mark {
            width: 76px;
            height: 76px;
            object-fit: cover;
            flex: 0 0 auto;
        }

        .donation-brand-wordmark {
            margin: 0;
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            flex: 1 1 0;
            min-width: 0;
            width: auto;
            font-size: clamp(44px, 6.8vw, 74px);
            line-height: 0.9;
            text-transform: uppercase;
            white-space: nowrap;
        }

        {% block extra_styles %}
        {% endblock %}

        @media (max-width: 700px) {
            :root {
                --content-width: calc(100vw - 30px);
            }

            .donation-page {
                padding: 28px 15px;
            }

            .donation-brand {
                height: 94px;
                gap: 14px;
                padding: 0 18px;
            }

            .donation-brand-wordmark {
                font-size: clamp(31px, 8.8vw, 42px);
            }

            .donation-brand-mark {
                width: 52px;
                height: 52px;
            }

            .donation-stage {
                transform: translateY(-12px);
            }

            {% block extra_mobile_styles %}
            {% endblock %}
            
        }
    </style>
</head>

<body>
    <div class="donation-page">
        <div class="donation-stage">
            {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
            <div class="donation-messages">
                {% for category, message in messages %}
                <div class="donation-message {{ category }}">{{ message }}</div>
                {% endfor %}
            </div>
            {% endif %}
            {% endwith %}

            {% block pre_brand %}{% endblock %}

            <div class="donation-brand" aria-hidden="true">
                <img class="donation-brand-mark" src="{{ url_for('static', filename='images/f0.jpg') }}" alt="">
                <h1 class="donation-brand-wordmark">F0RTHSP4CE</h1>
            </div>

            {% block content %}{% endblock %}
        </div>
    </div>

    {% block scripts %}{% endblock %}
</body>

</html>