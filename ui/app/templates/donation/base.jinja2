<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#000000">
    <title>{% block title %}whole hackerspace{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&family=Unbounded:wght@700&display=swap"
        rel="stylesheet">
    <style>
        /* One family, three sizes, four colours. Green marks donation controls
           and the currency artwork. */
        :root {
            --bg: #000000;
            --fg: #ffffff;
            --dim: #6e6e6e;
            --accent: #00ff00;
            --error: #ff3b30;

            --fs-line: clamp(24px, 4.4vw, 42px);
            --fs-cta: clamp(17px, 2vw, 21px);
            --fs-meta: 12px;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--fg);
            font-family: "Geist Mono", ui-monospace, monospace;
            font-size: var(--fs-meta);
            line-height: 1.5;
        }

        .stage {
            min-height: 100dvh;
            max-width: 860px;
            margin: 0 auto;
            padding: 26px 22px 22px;
            display: grid;
            grid-template-rows: auto 1fr auto;
            gap: 30px;
        }

        .mark,
        .foot {
            color: var(--dim);
            font-size: var(--fs-meta);
            letter-spacing: 0.06em;
        }

        .mark {
            margin: 0;
        }

        .foot {
            margin: 0;
        }

        .foot a {
            color: var(--dim);
            text-decoration: none;
            border-bottom: 1px solid var(--dim);
        }

        .foot a:hover,
        .foot a:focus-visible {
            color: var(--fg);
            border-bottom-color: var(--fg);
        }

        .notice {
            margin: 0;
            color: var(--error);
            font-size: var(--fs-meta);
        }

        :focus-visible {
            outline: 1px solid var(--accent);
            outline-offset: 4px;
        }

        {% block extra_styles %}{% endblock %}

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>

<body>
    <div class="stage">
        <p class="mark">F0RTHSP4CE</p>

        {% block content %}{% endblock %}

        <div>
            {% with messages = get_flashed_messages(with_categories=true) %}
            {% for category, message in messages %}
            <p class="notice">{{ message }}</p>
            {% endfor %}
            {% endwith %}
            {% block foot %}{% endblock %}
        </div>
    </div>

    {% block scripts %}{% endblock %}
</body>

</html>
