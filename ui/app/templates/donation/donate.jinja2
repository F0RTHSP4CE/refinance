{% extends "donation/base.jinja2" %}

{% block title %}Donate to F0RTHSP4CE{% endblock %}

{% block extra_styles %}
        :root {
            --muted: #2c2c2c;
            --muted-light: #dddddd;
            --submit-stripe-shift: 33.941px;
        }

        #donation-js-error:not([hidden]) {
            margin-bottom: 20px;
        }

        .donation-form {
            margin-top: 6rem;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .donation-name {
            width: 100%;
            border: 2px solid var(--surface-border);
            background: #000000;
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            font-size: clamp(25px, 4.2vw, 45px);
            font-weight: 700;
            line-height: 1;
            text-align: center;
            padding: 8px 28px;
            outline: none;
            height: 59px;
        }

        .donation-name:focus-visible {
            outline: 4px solid var(--accent);
            outline-offset: 4px;
        }

        .donation-name::placeholder {
            color: #4e4e4e;
            opacity: 1;
            font-size: 0.7em;
        }

        .preset-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

        .preset-option {
            --button-hover-border: var(--accent);
            border: 2px solid var(--surface-border);
            background: #000000;
            color: #ffffff;
            height: 64px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Geist Mono", monospace;
            font-size: clamp(28px, 4.5vw, 46px);
            font-weight: 700;
            line-height: 1;
            box-shadow: 0 0 0 0 transparent;
            transition: box-shadow 0.15s ease;
        }

        .preset-option:focus-visible {
            outline: 4px solid var(--accent);
            outline-offset: 4px;
        }

        .preset-option.is-selected {
            --button-hover-border: #ffffff;
            background: var(--accent);
            border-color: var(--accent);
            color: #000000;
        }

        .preset-option-label {
            display: inline-flex;
            align-items: baseline;
            gap: 16px;
        }

        .preset-option-currency {
            font-size: 0.75em;
            letter-spacing: 0;
        }

        .donation-submit {
            --button-hover-border: #ffffff;
            width: 100%;
            height: 62px;
            margin-top: 2rem;
            border: 0;
            background: var(--accent);
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            font-size: clamp(30px, 4.8vw, 48px);
            font-weight: 700;
            line-height: 1;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            box-shadow: 0 0 0 0 transparent;
        }

        @media (hover: hover) {

            .preset-option:not(:disabled):hover,
            .donation-submit:not(:disabled):hover {
                box-shadow: 0 0 0 4px var(--button-hover-border);
            }
        }

        .donation-submit-label {
            position: relative;
            z-index: 1;
        }

        .donation-submit::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: -100%;
            width: 300%;
            z-index: 0;
            opacity: 0;
            background-image: repeating-linear-gradient(45deg,
                    rgba(255, 255, 255, 0.16) 0,
                    rgba(255, 255, 255, 0.16) 12px,
                    rgba(0, 0, 0, 0.12) 12px,
                    rgba(0, 0, 0, 0.12) 24px);
            background-repeat: repeat;
            transform: translate3d(0, 0, 0);
            will-change: transform;
            pointer-events: none;
        }

        .donation-submit:focus-visible {
            outline: 4px solid #000000;
            outline-offset: 4px;
        }

        .donation-submit.is-loading,
        .donation-submit:disabled {
            cursor: progress;
            opacity: 1;
            background-color: var(--accent);
        }

        .donation-submit.is-loading::before,
        .donation-submit:disabled::before {
            opacity: 1;
            animation: donation-submit-stripes 1.1s linear infinite;
        }

        @keyframes donation-submit-stripes {
            from {
                transform: translate3d(calc(-1 * var(--submit-stripe-shift)), 0, 0);
            }

            to {
                transform: translate3d(0, 0, 0);
            }
        }

        /* ── type toggle ── */
        .donation-type-toggle {
            display: flex;
            gap: 0;
            margin-bottom: 0;
        }

        .type-tab {
            flex: 1;
            height: 52px;
            border: 2px solid var(--surface-border);
            background: #000000;
            color: #4e4e4e;
            font-family: "Geist Mono", monospace;
            font-size: clamp(14px, 2.2vw, 22px);
            font-weight: 700;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: color 0.12s, background 0.12s, border-color 0.12s;
        }

        .type-tab:first-child {
            border-right-width: 1px;
        }

        .type-tab:last-child {
            border-left-width: 1px;
        }

        .type-tab.is-active {
            background: var(--surface-border);
            color: #ffffff;
            border-color: var(--surface-border);
        }

        .type-tab:focus-visible {
            outline: 4px solid var(--accent);
            outline-offset: 4px;
        }

        /* ── tab sections ── */
        .donation-sections {
            display: grid;
            grid-template-columns: 1fr;
        }

        .donation-sections > #onetime-section,
        .donation-sections > #recurring-section {
            grid-area: 1 / 1;
            min-width: 0;
            margin-top: 2.5rem;
        }

        .donation-sections > [hidden] {
            display: block;
            visibility: hidden;
            pointer-events: none;
        }

        #onetime-section .preset-grid,
        #recurring-section .preset-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .recurring-hint {
            margin-top: 2rem;
            color: #4e4e4e;
            font-size: clamp(14px, 2vw, 18px);
            line-height: 1.4;
            text-align: center;
        }

        .donation-faq {
            margin-top: 1.5rem;
            font-size: clamp(12px, 1.8vw, 16px);
            line-height: 1.4;
            text-align: center;
        }

        .donation-faq details {
            margin-top: 0.75rem;
        }

        .donation-faq summary {
            color: #4e4e4e;
            cursor: pointer;
            list-style: none;
        }

        .donation-faq summary::-webkit-details-marker {
            display: none;
        }

        @media (hover: hover) {
            .donation-faq summary:hover {
                color: #888;
                text-decoration: underline;
            }
        }

        .donation-faq details[open] summary {
            margin-bottom: 0.5rem;
        }

        .donation-faq p {
            color: #4e4e4e;
            margin: 0 auto;
            max-width: 90%;
        }

        @media (min-width: 701px) {
            .donation-faq {
                display: flex;
                justify-content: center;
                gap: 2rem;
                font-size: 13px;
            }

            .donation-faq details {
                position: relative;
                margin-top: 0;
            }

            .donation-faq details[open] summary {
                margin-bottom: 0;
                position: relative;
                z-index: 101;
            }

            .donation-faq details[open]::before {
                content: "";
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.7);
                z-index: 99;
            }

            .donation-faq details[open] > :not(summary) {
                position: absolute;
                bottom: calc(100% + 14px);
                left: 50%;
                transform: translateX(-50%);
                width: 400px;
                max-width: calc(100vw - 64px);
                margin: 0;
                padding: 20px 24px;
                background: #000;
                border: 2px solid var(--surface-border);
                color: #ffffff;
                text-align: left;
                font-size: 15px;
                line-height: 1.5;
                z-index: 100;
            }

            .donation-faq details[open] > :not(summary)::before {
                content: "";
                position: absolute;
                bottom: -9px;
                left: 50%;
                width: 14px;
                height: 14px;
                background: #000;
                border-right: 2px solid var(--surface-border);
                border-bottom: 2px solid var(--surface-border);
                transform: translateX(-50%) rotate(45deg);
            }
        }

{% endblock %}

{% block extra_mobile_styles %}
            .donation-form {
                margin-top: 4rem;
            }

            .donation-name {
                height: 54px;
            }

            .preset-grid {
                gap: 8px;
                margin-top: 8px;
            }

            .preset-option {
                height: 58px;
            }

            .donation-submit {
                margin-top: 2rem;
                height: 58px;
            }

            .donation-faq summary::before {
                content: "▶";
                display: inline-block;
                margin-right: 0.5em;
                font-size: 0.7em;
                transition: transform 0.15s ease;
            }

            .donation-faq details[open] summary::before {
                transform: rotate(90deg);
            }
{% endblock %}

{% block pre_brand %}
            <div id="donation-js-error" class="donation-message error" hidden></div>
{% endblock %}

{% block content %}

            <form method="post" class="donation-form" novalidate>
                <input type="hidden" id="donation-type" name="type" value="{{ form_data.type }}">

                {% if stripe_configured %}
                <div class="donation-type-toggle" role="group" aria-label="Donation type">
                    <button type="button" class="type-tab{% if form_data.type != 'recurring' %} is-active{% endif %}"
                        data-type="onetime">One-time</button>
                    <button type="button" class="type-tab{% if form_data.type == 'recurring' %} is-active{% endif %}"
                        data-type="recurring">Monthly</button>
                </div>
                {% endif %}

                <div class="donation-sections">
                <div id="onetime-section" {% if stripe_configured and form_data.type=='recurring' %} hidden{% endif %}>
                    <label class="sr-only" for="comment">Your name</label>
                    <input id="comment" name="comment" class="donation-name" type="text" maxlength="120"
                        value="{{ form_data.comment }}" placeholder="name / comment (optional)" autocomplete="off">

                    <input id="preset_amount" name="preset_amount" type="hidden" value="{{ form_data.preset_amount }}">
                    <input id="onetime_currency_value" name="onetime_currency" type="hidden"
                        value="{{ form_data.onetime_currency }}">

                    <div class="preset-grid" role="group" aria-label="Donation amount presets">
                        {% for preset in donation_presets %}
                        <button type="button"
                            class="preset-option{% if form_data.preset_amount == preset %} is-selected{% endif %}"
                            data-amount="{{ preset }}"
                            aria-pressed="{{ 'true' if form_data.preset_amount == preset else 'false' }}">
                            <span class="preset-option-label">{{ preset }}<span class="preset-option-currency">$</span></span>
                        </button>
                        {% endfor %}
                    </div>

                    <button type="submit" class="donation-submit"><span
                            class="donation-submit-label">Donate</span></button>

                    <p class="recurring-hint">We accept any cards and Apple Pay.</p>

                    <div class="donation-faq">
                        <details>
                            <summary>Is my donation secure?</summary>
                            <p>Yes, we use industry-standard SSL technology to keep your information secure.<br><br>We partner with Stripe, the industry's established payment processor trusted by some of the world's largest companies.<br><br>Your sensitive financial information never touches our servers. We send all data directly to Stripe's PCI-compliant servers through SSL.</p>
                        </details>
                        <details>
                            <summary>Can I cancel my recurring donation?</summary>
                            <p>Of course. You always remain in full control of your recurring donation, and you’re free to change or cancel it at any time.</p>
                        </details>
                    </div>
                </div>

                {% if stripe_configured %}
                <div id="recurring-section" {% if form_data.type !='recurring' %} hidden{% endif %}>
                    <label class="sr-only" for="recurring-comment">Your name</label>
                    <input id="recurring-comment" name="recurring_comment" class="donation-name" type="text"
                        maxlength="120" value="{{ form_data.recurring_comment }}" placeholder="name / comment (optional)"
                        autocomplete="off">

                    <input id="recurring_preset_amount" name="recurring_preset_amount" type="hidden"
                        value="{{ form_data.recurring_preset_amount }}">
                    <input id="recurring_currency_value" name="recurring_currency" type="hidden"
                        value="{{ form_data.recurring_currency }}">

                    <div class="preset-grid" role="group" aria-label="Monthly donation amount presets">
                        {% for preset in donation_presets %}
                        <button type="button"
                            class="preset-option{% if form_data.recurring_preset_amount == preset %} is-selected{% endif %}"
                            data-amount="{{ preset }}"
                            aria-pressed="{{ 'true' if form_data.recurring_preset_amount == preset else 'false' }}">
                            <span class="preset-option-label">{{ preset }}<span class="preset-option-currency">$</span></span>
                        </button>
                        {% endfor %}
                    </div>

                    <button type="submit" class="donation-submit"><span
                            class="donation-submit-label">Subscribe</span></button>

                    <p class="recurring-hint">Your card will be charged every month.</p>

                    <div class="donation-faq">
                        <details>
                            <summary>Is my donation secure?</summary>
                            <p>Yes, we use industry-standard SSL technology to keep your information secure.<br><br>We partner with Stripe, the industry's established payment processor trusted by some of the world's largest companies.<br><br>Your sensitive financial information never touches our servers. We send all data directly to Stripe's PCI-compliant servers through SSL.</p>
                        </details>
                        <details>
                            <summary>Can I cancel my recurring donation?</summary>
                            <p>Of course. You always remain in full control of your recurring donation, and you’re free to change or cancel it at any time.</p>
                        </details>
                    </div>
                </div>
                {% endif %}
                </div>
            </form>
{% endblock %}

{% block scripts %}
    <script>
        const DONATION_MIN_AMOUNT = {{ donation_min_amount | tojson }};
        const DONATION_MAX_AMOUNT = {{ donation_max_amount | tojson }};

        const donationForm = document.querySelector(".donation-form");
        const donationTypeInput = document.getElementById("donation-type");
        const presetInput = document.getElementById("preset_amount");
        const presetButtons = Array.from(document.querySelectorAll("#onetime-section .preset-option"));
        const submitButtons = Array.from(document.querySelectorAll(".donation-submit"));
        const jsErrorContainer = document.getElementById("donation-js-error");
        const onetimeSection = document.getElementById("onetime-section");
        const recurringSection = document.getElementById("recurring-section");
        const typeTabs = Array.from(document.querySelectorAll(".type-tab"));
        const recurringPresetInput = document.getElementById("recurring_preset_amount");
        const recurringPresetButtons = Array.from(document.querySelectorAll("#recurring-section .preset-option"));
        let isSubmitting = false;

        function showJsError(message) {
            jsErrorContainer.textContent = message;
            jsErrorContainer.hidden = false;
        }

        function clearJsError() {
            jsErrorContainer.hidden = true;
            jsErrorContainer.textContent = "";
        }

        function formatAmount(n) {
            return n % 1 === 0 ? String(n) : n.toFixed(2).replace(/\.?0+$/, "");
        }

        function updatePresetSelection(buttons, selectedAmount) {
            buttons.forEach((button) => {
                const isSelected = button.dataset.amount === selectedAmount;
                button.classList.toggle("is-selected", isSelected);
                button.setAttribute("aria-pressed", isSelected ? "true" : "false");
            });
        }

        function switchTab(type) {
            donationTypeInput.value = type;
            typeTabs.forEach((tab) => tab.classList.toggle("is-active", tab.dataset.type === type));
            if (onetimeSection) onetimeSection.hidden = (type === "recurring");
            if (recurringSection) recurringSection.hidden = (type !== "recurring");
            clearJsError();
        }

        typeTabs.forEach((tab) => {
            tab.addEventListener("click", () => switchTab(tab.dataset.type));
        });

        presetButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const amount = button.dataset.amount;
                presetInput.value = amount;
                updatePresetSelection(presetButtons, amount);
            });
        });

        recurringPresetButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const amount = button.dataset.amount;
                recurringPresetInput.value = amount;
                updatePresetSelection(recurringPresetButtons, amount);
            });
        });

        donationForm.addEventListener("submit", (event) => {
            clearJsError();
            const currentType = donationTypeInput ? donationTypeInput.value : "onetime";
            const rawValue = currentType === "recurring"
                ? (recurringPresetInput ? recurringPresetInput.value.trim() : "")
                : presetInput.value.trim();

            if (!rawValue) {
                event.preventDefault();
                showJsError(currentType === "recurring"
                    ? "Select a monthly amount."
                    : "Select a donation amount.");
                return;
            }

            const amount = parseFloat(rawValue.replace(",", "."));
            if (isNaN(amount) || amount <= 0) {
                event.preventDefault();
                showJsError("Enter a valid donation amount.");
                return;
            }
            if (amount < DONATION_MIN_AMOUNT) {
                event.preventDefault();
                showJsError(`Donation amount must be at least ${formatAmount(DONATION_MIN_AMOUNT)}.`);
                return;
            }
            if (amount > DONATION_MAX_AMOUNT) {
                event.preventDefault();
                showJsError(`Donation amount must be at most ${formatAmount(DONATION_MAX_AMOUNT)}.`);
                return;
            }

            if (isSubmitting) {
                event.preventDefault();
                return;
            }

            isSubmitting = true;
            donationForm.setAttribute("aria-busy", "true");
            submitButtons.forEach((btn) => {
                btn.disabled = true;
                btn.classList.add("is-loading");
            });
        });

        updatePresetSelection(presetButtons, presetInput.value);
        if (recurringPresetInput) updatePresetSelection(recurringPresetButtons, recurringPresetInput.value);

        const faqDetails = Array.from(document.querySelectorAll(".donation-faq details"));
        faqDetails.forEach((d) => {
            d.addEventListener("toggle", () => {
                if (d.open) {
                    faqDetails.forEach((other) => {
                        if (other !== d) other.open = false;
                    });
                }
            });
        });
        document.addEventListener("click", (event) => {
            faqDetails.forEach((d) => {
                if (!d.open) return;
                if (event.target === d || !d.contains(event.target)) {
                    d.open = false;
                }
            });
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                faqDetails.forEach((d) => { d.open = false; });
            }
        });
    </script>
{% endblock %}