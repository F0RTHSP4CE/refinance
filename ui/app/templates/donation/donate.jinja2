{% extends "donation/base.jinja2" %}

{% block title %}Give to F0RTHSP4CE{% endblock %}

{% block extra_styles %}
.sr-only {
position: absolute;
width: 1px;
height: 1px;
padding: 0;
margin: -1px;
overflow: hidden;
clip: rect(0, 0, 0, 0);
white-space: nowrap;
border: 0;
}

.middle {
align-self: center;
}

/* ── the form is one sentence; every slot is a field ── */
.line {
margin: 0;
font-size: var(--fs-line);
font-weight: 700;
line-height: 1.5;
letter-spacing: -0.01em;
}

/* one clause per line, so the sentence never breaks on a connector */
.clause {
display: block;
}

.slot {
font: inherit;
letter-spacing: inherit;
color: var(--fg);
background: none;
border: 0;
border-bottom: 2px solid var(--accent);
border-radius: 0;
padding: 0;
cursor: pointer;
transition: color 0.1s;
}

.slot:hover,
.slot:focus-visible {
color: var(--accent);
}

.slot:focus-visible {
outline: 0;
}

input.slot {
cursor: text;
outline: 0;
caret-color: var(--accent);
min-width: 1ch;
}

input.slot::placeholder {
color: var(--dim);
opacity: 1;
}

input.slot:focus {
color: var(--accent);
}

/* the handle and the number are one control, so they share one unbroken rule */
.counter {
white-space: nowrap;
border-bottom: 2px solid var(--accent);
}

.counter > .slot {
border-bottom: 0;
}

.line.is-error .counter {
border-bottom-color: var(--error);
}

/* ── picking a place takes over: the whole list at once, at full size ── */
.picker-key {
margin: 0 0 1.5rem;
color: var(--dim);
font-size: var(--fs-meta);
letter-spacing: 0.06em;
}

.rooms {
margin: 0;
padding: 0;
list-style: none;
}

.room {
display: block;
background: none;
border: 0;
padding: 0;
font: inherit;
font-size: var(--fs-line);
font-weight: 700;
line-height: 1.35;
letter-spacing: -0.01em;
color: var(--dim);
text-align: left;
cursor: pointer;
transition: color 0.1s;
}

.room.is-on {
color: var(--accent);
}

.room:hover {
color: var(--fg);
}

/* an eyebrow: it explains the sentence before you read it, and stays out of the
   way of the sentence → action bond below */
.hint {
margin: 0 0 1.3rem;
color: var(--dim);
font-size: var(--fs-meta);
letter-spacing: 0.06em;
}

/* ── the one action ── */
.send {
display: inline-block;
margin: 2.4rem 0 0;
padding: 6px 0;
background: none;
border: 0;
border-bottom: 2px solid var(--accent);
font: inherit;
font-size: var(--fs-cta);
font-weight: 700;
color: var(--accent);
letter-spacing: 0.02em;
cursor: pointer;
}

.send:hover {
color: var(--fg);
border-bottom-color: var(--fg);
}

.send:disabled {
cursor: progress;
color: var(--dim);
border-bottom-color: var(--dim);
}

.send .caret {
display: none;
width: 0.5ch;
height: 0.85em;
margin-left: 0.4ch;
background: var(--accent);
vertical-align: -0.1em;
}

.send.is-sending .caret {
display: inline-block;
animation: blink 1s steps(1) infinite;
}

@keyframes blink {
0%, 100% { opacity: 1; }
50% { opacity: 0; }
}

#donation-js-error:not([hidden]) {
margin: 1.6rem 0 0;
}

/* ── fee note: a full-bleed sheet, no box ── */
.fee {
width: 100%;
max-width: none;
max-height: none;
height: 100%;
margin: 0;
padding: 26px 22px 22px;
border: 0;
background: var(--bg);
color: var(--fg);
font-family: inherit;
}

.fee::backdrop {
background: var(--bg);
}

.fee-body {
max-width: 860px;
margin: 0 auto;
height: 100%;
display: grid;
align-content: center;
}

.fee-text {
margin: 0;
max-width: min(26ch, 100%);
font-size: var(--fs-line);
font-weight: 700;
line-height: 1.42;
letter-spacing: -0.01em;
}

.fee-text b {
color: var(--accent);
font-weight: inherit;
}

.fee-acts {
display: flex;
flex-wrap: wrap;
gap: 1.6em 2.4em;
margin-top: 2.4rem;
}

.fee-acts .send {
margin: 0;
}

.fee-keep {
background: none;
border: 0;
border-bottom: 1px solid var(--dim);
padding: 6px 0;
font: inherit;
font-size: var(--fs-cta);
color: var(--dim);
cursor: pointer;
}

.fee-keep:hover {
color: var(--fg);
border-bottom-color: var(--fg);
}
{% endblock %}

{% set is_recurring = form_data.type == 'recurring' and stripe_configured %}
{% set amount = (form_data.recurring_custom_amount or form_data.recurring_preset_amount) if is_recurring else
(form_data.custom_amount or form_data.preset_amount) %}
{% set currency = form_data.recurring_currency if is_recurring else form_data.onetime_currency %}
{% set comment = form_data.recurring_comment if is_recurring else form_data.comment %}
{% set recipient = form_data.recurring_recipient if is_recurring else form_data.onetime_recipient %}
{% set symbols = {"USD": "$", "EUR": "€", "GEL": "₾"} %}
{% set ns = namespace(room="the whole space") %}
{% for r in recipients %}{% if recipient == r.id|string and not r.general %}{% set ns.room = r.name %}{% endif %}{%
endfor %}

{% block content %}
<div class="middle">
    <form method="post" novalidate>
        <input type="hidden" name="type" value="{{ 'recurring' if is_recurring else 'onetime' }}" data-role="type">
        <input type="hidden" name="custom_amount" data-mirror="amount">
        <input type="hidden" name="recurring_custom_amount" data-mirror="amount">
        <input type="hidden" name="onetime_currency" data-mirror="currency">
        <input type="hidden" name="recurring_currency" data-mirror="currency">
        <input type="hidden" name="comment" data-mirror="name">
        <input type="hidden" name="recurring_comment" data-mirror="name">
        <input type="hidden" name="onetime_recipient" data-mirror="recipient">
        <input type="hidden" name="recurring_recipient" data-mirror="recipient">

        <div data-role="compose">
            <p class="hint">click anything underlined to change it</p>

            <p class="line" data-role="line">
            <span class="clause"><span class="counter"><button type="button" class="slot" data-role="step"
                        aria-label="Suggest another amount" title="Another amount">give</button>
                    <label class="sr-only" for="amount">Amount</label><input id="amount" class="slot amount"
                        data-role="amount" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="go"
                        value="{{ amount }}" placeholder="0" maxlength="8"
                        style="width: {{ [amount|length, 2] | max }}ch"></span>
                <button type="button" class="slot" data-role="currency"
                    aria-label="Currency: {{ currency }}. Change.">{{ symbols.get(currency, "$") }}</button>
                {% if stripe_configured %}<span data-role="freq-lead">{{ 'each' if is_recurring else 'just'
                    }}</span> <button type="button" class="slot" data-role="freq"
                    aria-label="How often. Change.">{{ 'month' if is_recurring else 'once' }}</button>{% else %}just
                once{% endif %}</span>
            <span class="clause">to <button type="button" class="slot" data-role="dest" aria-expanded="false"
                    aria-controls="rooms">{{ ns.room }}</button></span>
            <span class="clause">from
                <label class="sr-only" for="name">Your name</label><input id="name" class="slot name" data-role="name"
                    type="text" maxlength="120" value="{{ comment }}" placeholder="anonymous" autocomplete="off"
                    style="width: {{ [comment|length, 9] | max }}ch"></span>
            </p>

            <p id="donation-js-error" class="notice" role="alert" hidden></p>

            <button type="submit" class="send" data-role="send">send it → <span class="caret"
                    aria-hidden="true"></span></button>
        </div>

        <div id="rooms" data-role="picker" hidden>
            <p class="picker-key">where it goes</p>
            <ul class="rooms">
                {% for r in recipients %}
                <li><button type="button" class="room{% if recipient == r.id|string %} is-on{% endif %}"
                        data-id="{{ r.id }}" data-general="{{ '1' if r.general else '0' }}"
                        data-label="{{ 'the whole space' if r.general else r.name }}">{{ 'the whole space' if r.general
                        else r.name }}</button></li>
                {% endfor %}
            </ul>
        </div>
    </form>
</div>

{% if stripe_configured %}
<dialog id="fee" class="fee" aria-labelledby="fee-text">
    <div class="fee-body">
        <p id="fee-text" class="fee-text">under <b data-role="fee-threshold">10 ₾</b> a month, fees eat most of it.</p>
        <div class="fee-acts">
            <button type="button" class="send" data-role="fee-raise" autofocus>give <span
                    data-role="fee-threshold">10 ₾</span> instead</button>
            <button type="button" class="fee-keep" data-role="fee-keep">keep <span
                    data-role="fee-keep-amount">5 ₾</span></button>
        </div>
    </div>
</dialog>
{% endif %}
{% endblock %}

{% block foot %}
<p class="foot" data-role="foot"></p>
{% endblock %}

{% block scripts %}
<script>
    (function () {
        "use strict";

        const MIN = parseFloat({{ donation_min_amount | string | tojson }});
        const MAX = parseFloat({{ donation_max_amount | string | tojson }});
        const STRIPE = {{ 'true' if stripe_configured else 'false' }};
        const PRESETS = { USD: ["5", "10", "25"], EUR: ["5", "10", "25"], GEL: ["10", "25", "50"] };
        const SYMBOLS = { USD: "$", EUR: "€", GEL: "₾" };
        const ORDER = ["GEL", "USD", "EUR"];
        // ~10 GEL equivalents: below this, payout fees eat most of a monthly gift
        const THRESHOLDS = { GEL: 10, USD: 4, EUR: 4 };
        const FOOT = {
            recurring: 'stripe · cancel any time · <a href="https://billing.stripe.com/p/login/dRmdRaerygMda2Gflgbsc00" target="_blank" rel="noopener noreferrer">manage yours</a>',
            onetime: "keepz · card or apple pay · no account"
        };

        const form = document.querySelector("form");
        const line = document.querySelector('[data-role="line"]');
        const typeInput = document.querySelector('[data-role="type"]');
        const amountInput = document.querySelector('[data-role="amount"]');
        const stepBtn = document.querySelector('[data-role="step"]');
        const nameInput = document.querySelector('[data-role="name"]');
        const currencyBtn = document.querySelector('[data-role="currency"]');
        const freqBtn = document.querySelector('[data-role="freq"]');
        const freqLead = document.querySelector('[data-role="freq-lead"]');
        const destBtn = document.querySelector('[data-role="dest"]');
        const compose = document.querySelector('[data-role="compose"]');
        const picker = document.querySelector('[data-role="picker"]');
        const sendBtn = document.querySelector('[data-role="send"]');
        const errorBox = document.getElementById("donation-js-error");
        const foot = document.querySelector('[data-role="foot"]');
        const mirrors = Array.from(document.querySelectorAll("[data-mirror]"));

        const state = {
            type: typeInput.value,
            currency: (document.querySelector('[name="recurring_currency"]').value || "USD"),
            recipient: (picker.querySelector(".room.is-on") || { dataset: {} }).dataset.id || ""
        };
        // the server rendered the symbol, not the code — read the code back from it
        state.currency = Object.keys(SYMBOLS).find((c) => SYMBOLS[c] === currencyBtn.textContent.trim()) || "USD";
        let sending = false;

        function num(raw) {
            return parseFloat(String(raw).replace(",", "."));
        }

        function fmt(n) {
            return n % 1 === 0 ? String(n) : n.toFixed(2).replace(/\.?0+$/, "");
        }

        function symbol() {
            return SYMBOLS[state.currency] || "$";
        }

        function presets() {
            return PRESETS[state.currency] || PRESETS.USD;
        }

        function isRecurring() {
            return STRIPE && state.type === "recurring";
        }

        function showError(message) {
            errorBox.textContent = message;
            errorBox.hidden = false;
            line.classList.add("is-error");
        }

        function clearError() {
            errorBox.hidden = true;
            errorBox.textContent = "";
            line.classList.remove("is-error");
        }

        function fitInput(input, min) {
            const len = (input.value || input.placeholder || "").length;
            input.style.width = Math.max(len, min) + "ch";
        }

        function render() {
            fitInput(amountInput, 2);
            fitInput(nameInput, 9);
            currencyBtn.textContent = symbol();
            currencyBtn.setAttribute("aria-label", "Currency: " + state.currency + ". Change.");
            // the lead word stays plain white, so the run of rules is broken mid-line.
            // keep the two lead words the same length — the font is monospaced, so
            // equal length is what stops the slot beside them from sliding on a swap
            if (freqBtn) {
                freqBtn.textContent = isRecurring() ? "month" : "once";
                if (freqLead) freqLead.textContent = isRecurring() ? "each" : "just";
            }
            typeInput.value = state.type;
            picker.querySelectorAll(".room").forEach((room) => {
                const on = room.dataset.id === state.recipient;
                room.classList.toggle("is-on", on);
                if (on) destBtn.textContent = room.dataset.label;
            });
            mirrors.forEach((el) => {
                const key = el.dataset.mirror;
                if (key === "amount") el.value = amountInput.value.trim();
                if (key === "currency") el.value = state.currency;
                if (key === "name") el.value = nameInput.value.trim();
                if (key === "recipient") el.value = state.recipient;
            });
            if (foot) foot.innerHTML = isRecurring() ? FOOT.recurring : FOOT.onetime;
        }

        // "give" never changes its label, so it stays a target you can hit at any
        // time — including when the slot holds a number of your own, which restarts
        // the cycle from the first suggestion
        stepBtn.addEventListener("click", () => {
            const list = presets();
            const at = list.findIndex((p) => num(p) === num(amountInput.value));
            amountInput.value = list[(at + 1) % list.length];
            clearError();
            render();
        });

        amountInput.addEventListener("input", () => {
            let clean = amountInput.value.replace(/[^0-9.,]/g, "");
            const sep = clean.search(/[.,]/);
            if (sep !== -1) clean = clean.slice(0, sep + 1) + clean.slice(sep + 1).replace(/[.,]/g, "");
            clean = clean.replace(/([.,]\d{2})\d+$/, "$1");
            if (clean !== amountInput.value) amountInput.value = clean;
            clearError();
            render();
        });

        amountInput.addEventListener("blur", () => {
            amountInput.value = amountInput.value.trim().replace(/[.,]$/, "");
            render();
        });

        nameInput.addEventListener("input", render);

        // switching currency keeps the chosen tier (10 $ → 25 ₾)
        currencyBtn.addEventListener("click", () => {
            const tier = presets().findIndex((p) => num(p) === num(amountInput.value));
            state.currency = ORDER[(ORDER.indexOf(state.currency) + 1) % ORDER.length];
            if (tier >= 0) amountInput.value = presets()[tier];
            clearError();
            render();
        });

        if (freqBtn) {
            freqBtn.addEventListener("click", () => {
                state.type = isRecurring() ? "onetime" : "recurring";
                clearError();
                render();
            });
        }

        // choosing a place is its own view: the sentence steps aside and the whole
        // list stands in its place, so nothing hangs off the end of a line
        function showPicker(open) {
            compose.hidden = open;
            picker.hidden = !open;
            destBtn.setAttribute("aria-expanded", open ? "true" : "false");
            if (open) {
                const current = picker.querySelector(".room.is-on") || picker.querySelector(".room");
                if (current) current.focus();
            } else {
                destBtn.focus();
            }
        }

        destBtn.addEventListener("click", () => showPicker(true));

        picker.addEventListener("click", (event) => {
            const room = event.target.closest(".room");
            if (!room) return;
            state.recipient = room.dataset.id;
            render();
            showPicker(false);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !picker.hidden) showPicker(false);
        });

        const fee = document.getElementById("fee");
        let feeAccepted = false;

        function threshold() {
            return THRESHOLDS[state.currency];
        }

        function resubmit() {
            if (form.requestSubmit) form.requestSubmit();
            else form.submit();
        }

        if (fee) {
            fee.querySelector('[data-role="fee-raise"]').addEventListener("click", () => {
                amountInput.value = String(threshold());
                render();
                fee.close();
                resubmit();
            });
            fee.querySelector('[data-role="fee-keep"]').addEventListener("click", () => {
                feeAccepted = true;
                fee.close();
                resubmit();
            });
        }

        function openFee() {
            const label = threshold() + " " + symbol();
            fee.querySelectorAll('[data-role="fee-threshold"]').forEach((el) => {
                el.textContent = label;
            });
            const keep = fee.querySelector('[data-role="fee-keep-amount"]');
            if (keep) keep.textContent = amountInput.value.trim() + " " + symbol();
            fee.showModal();
        }

        function validate() {
            const raw = amountInput.value.trim();
            if (!raw) return "pick an amount, or type one";
            if (!/^\d+(?:[.,]\d{1,2})?$/.test(raw)) return "numbers only, up to 2 decimals";
            const value = num(raw);
            if (isNaN(value) || value <= 0) return "more than zero, please";
            if (value < MIN) return "the smallest we can take is " + fmt(MIN);
            if (value > MAX) return "the largest we can take here is " + fmt(MAX);
            return null;
        }

        form.addEventListener("submit", (event) => {
            clearError();
            const error = validate();
            if (error) {
                event.preventDefault();
                showError(error);
                amountInput.focus();
                return;
            }
            if (isRecurring() && fee && !feeAccepted && threshold() && num(amountInput.value) < threshold()) {
                event.preventDefault();
                openFee();
                return;
            }
            if (sending) {
                event.preventDefault();
                return;
            }
            sending = true;
            sendBtn.disabled = true;
            sendBtn.classList.add("is-sending");
            sendBtn.firstChild.textContent = "sending ";
        });

        render();
    })();
</script>
{% endblock %}
