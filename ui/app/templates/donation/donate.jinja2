{% extends 'base.jinja2' %}

{% block title %}Donate to F0RTHSP4CE{% endblock %}

{% block content %}
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="login-title">Donate to F0RTHSP4CE</h2>
            <p class="login-subtitle">Support the hackerspace — any amount is welcome</p>
        </div>

        {% with messages = get_flashed_messages(with_categories=true) %}
        {% for category, message in messages %}
        <div class="message {{ category }}">{{ message }}</div>
        {% endfor %}
        {% endwith %}

        <form method="post" class="login-form">
            {{ form.csrf_token }}

            <div class="form-group">
                <label class="form-label">{{ form.amount.label.text }}</label>
                <div class="input-wrapper">
                    {{ form.amount(class="form-input") }}
                    {{ form.currency(class="form-input") }}
                </div>
                {% if form.amount.errors %}
                <div class="field-error">{{ form.amount.errors[0] }}</div>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="{{ form.comment.id }}" class="form-label">{{ form.comment.label.text }}</label>
                <div class="input-wrapper">
                    {{ form.comment(class="form-input") }}
                </div>
            </div>

            <div class="form-group">
                {{ form.submit(class="login-button") }}
            </div>
        </form>
    </div>
</div>
{% endblock %}