<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <title>Donate to F0RTHSP4CE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css"
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --page-bg: #ffffff;
            --ink: #000000;
            --muted: #2c2c2c;
            --muted-light: #dddddd;
            --accent: #00ff00;
            --content-width: min(626px, calc(100vw - 48px));
            --submit-stripe-shift: 33.941px;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
            margin: 0;
            background: var(--page-bg);
            color: var(--ink);
        }

        body {
            font-family: "Geist Mono", monospace;
        }

        .donation-page {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 24px;
        }

        .donation-stage {
            width: var(--content-width);
            transform: translateY(-18px);
        }

        .donation-messages {
            margin-bottom: 20px;
            display: grid;
            gap: 10px;
        }

        .donation-message {
            padding: 12px 16px;
            border: 3px solid #ff3b30;
            background: #fff3f2;
            color: #8a140d;
            font-size: 18px;
            line-height: 1.3;
        }

        #donation-js-error:not([hidden]) {
            margin-bottom: 20px;
        }

        .donation-brand {
            height: 121px;
            background: #000000;
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 0 36px;
        }

        .donation-brand-mark {
            width: 76px;
            height: 76px;
            object-fit: cover;
            flex: 0 0 auto;
        }

        .donation-brand-wordmark {
            margin: 0;
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            flex: 1 1 0;
            min-width: 0;
            width: auto;
            font-size: clamp(44px, 6.8vw, 74px);
            line-height: 0.9;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .donation-form {
            margin-top: 6rem;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .donation-name,
        .custom-amount-field {
            width: 100%;
            border: 0;
            background: #000000;
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            font-size: clamp(25px, 4.2vw, 45px);
            font-weight: 700;
            line-height: 1;
            text-align: center;
            padding: 8px 28px;
            outline: none;
            height: 59px;
        }

        .donation-name:focus-visible,
        .custom-amount-field:focus-visible {
            outline: 4px solid var(--accent);
            outline-offset: 4px;
        }

        .donation-name::placeholder {
            color: #4e4e4e;
            opacity: 1;
        }

        .preset-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

        .preset-option {
            --button-hover-border: #000000;
            border: 4px solid #000000;
            background: #000000;
            color: #ffffff;
            height: 64px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Geist Mono", monospace;
            font-size: clamp(28px, 4.5vw, 46px);
            font-weight: 700;
            line-height: 1;
            box-shadow: 0 0 0 0 transparent;
        }

        .preset-option:focus-visible {
            outline: 4px solid var(--accent);
            outline-offset: 4px;
        }

        .preset-option:disabled,
        .preset-option.is-inactive {
            opacity: 0.15;
            cursor: default;
        }

        .preset-option.is-selected {
            --button-hover-border: var(--accent);
            background: var(--accent);
            border-color: var(--accent);
            color: #000000;
        }

        .preset-option-label {
            display: inline-flex;
            align-items: baseline;
            gap: 16px;
        }

        .preset-option-currency {
            font-size: 0.75em;
            letter-spacing: 0;
        }

        .donation-submit {
            --button-hover-border: var(--accent);
            width: 100%;
            height: 62px;
            margin-top: 2rem;
            border: 0;
            background: var(--accent);
            color: #ffffff;
            font-family: "Geist Mono", monospace;
            font-size: clamp(30px, 4.8vw, 48px);
            font-weight: 700;
            line-height: 1;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            box-shadow: 0 0 0 0 transparent;
        }

        @media (hover: hover) {

            .preset-option:not(:disabled):hover,
            .donation-submit:not(:disabled):hover {
                box-shadow: 0 0 0 4px var(--button-hover-border);
            }
        }

        .donation-submit-label {
            position: relative;
            z-index: 1;
        }

        .donation-submit::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: -100%;
            width: 300%;
            z-index: 0;
            opacity: 0;
            background-image: repeating-linear-gradient(45deg,
                    rgba(255, 255, 255, 0.16) 0,
                    rgba(255, 255, 255, 0.16) 12px,
                    rgba(0, 0, 0, 0.12) 12px,
                    rgba(0, 0, 0, 0.12) 24px);
            background-repeat: repeat;
            transform: translate3d(0, 0, 0);
            will-change: transform;
            pointer-events: none;
        }

        .donation-submit:focus-visible {
            outline: 4px solid #000000;
            outline-offset: 4px;
        }

        .donation-submit.is-loading,
        .donation-submit:disabled {
            cursor: progress;
            opacity: 1;
            background-color: var(--accent);
        }

        .donation-submit.is-loading::before,
        .donation-submit:disabled::before {
            opacity: 1;
            animation: donation-submit-stripes 1.1s linear infinite;
        }

        @keyframes donation-submit-stripes {
            from {
                transform: translate3d(calc(-1 * var(--submit-stripe-shift)), 0, 0);
            }

            to {
                transform: translate3d(0, 0, 0);
            }
        }

        .custom-amount-wrap {
            display: flex;
            justify-content: center;
            margin-top: 2rem;
        }

        .custom-amount-shell {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 53px;
            gap: 14px;
            position: relative;
        }

        .custom-amount-field {
            width: auto;
            min-width: 96px;
            max-width: 320px;
            height: 53px;
            background: transparent;
            color: #111111;
            font-size: clamp(23px, 3.7vw, 43px);
            padding: 0;
        }

        .custom-amount-sizer {
            position: absolute;
            visibility: hidden;
            white-space: pre;
            font-family: "Geist Mono", monospace;
            font-size: clamp(23px, 3.7vw, 43px);
            font-weight: 700;
            line-height: 1;
        }

        .custom-amount-field::placeholder {
            color: #e8e8e8;
            opacity: 1;
        }

        .custom-amount-field:focus {
            color: #000000;
        }

        .custom-amount-suffix {
            font-family: "Geist Mono", monospace;
            font-size: clamp(23px, 3.7vw, 43px);
            font-weight: 700;
            line-height: 1;
            color: #111111;
            opacity: 0;
            transform: translateX(-8px);
            pointer-events: none;
        }

        .custom-amount-shell.has-value .custom-amount-suffix {
            opacity: 1;
            transform: translateX(0);
        }

        @media (max-width: 700px) {
            :root {
                --content-width: calc(100vw - 30px);
            }

            .donation-page {
                padding: 28px 15px;
            }

            .donation-brand {
                height: 94px;
                gap: 14px;
                padding: 0 18px;
            }

            .donation-brand-wordmark {
                font-size: clamp(31px, 8.8vw, 42px);
            }

            .donation-brand-mark {
                width: 52px;
                height: 52px;
            }

            .donation-form {
                margin-top: 4rem;
            }

            .donation-stage {
                transform: translateY(-12px);
            }

            .donation-name,
            .custom-amount-field {
                height: 54px;
            }

            .preset-grid {
                gap: 8px;
                margin-top: 8px;
            }

            .preset-option {
                height: 58px;
            }

            .donation-submit {
                margin-top: 1rem;
                height: 58px;
            }

            .custom-amount-wrap {
                margin-top: 16px;
            }

            .custom-amount-shell {
                gap: 10px;
            }

            .custom-amount-field {
                max-width: 280px;
            }
        }
    </style>
</head>

<body>
    <div class="donation-page">
        <div class="donation-stage">
            {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
            <div class="donation-messages">
                {% for category, message in messages %}
                <div class="donation-message {{ category }}">{{ message }}</div>
                {% endfor %}
            </div>
            {% endif %}
            {% endwith %}
            <div id="donation-js-error" class="donation-message error" hidden></div>

            <div class="donation-brand" aria-hidden="true">
                <img class="donation-brand-mark" src="{{ url_for('static', filename='images/f0.jpg') }}" alt="">
                <h1 class="donation-brand-wordmark">F0RTHSP4CE</h1>
            </div>

            <form method="post" class="donation-form" novalidate>
                <label class="sr-only" for="comment">Your name</label>
                <input id="comment" name="comment" class="donation-name" type="text" maxlength="120"
                    value="{{ form_data.comment }}" placeholder="your name / comment" autocomplete="off">

                <input id="preset_amount" name="preset_amount" type="hidden" value="{{ form_data.preset_amount }}">

                <div class="preset-grid" role="group" aria-label="Donation amount presets">
                    {% for preset in donation_presets %}
                    <button type="button"
                        class="preset-option{% if form_data.preset_amount == preset and not form_data.custom_amount %} is-selected{% endif %}{% if form_data.custom_amount %} is-inactive{% endif %}"
                        data-amount="{{ preset }}"
                        aria-pressed="{{ 'true' if form_data.preset_amount == preset and not form_data.custom_amount else 'false' }}"
                        {% if form_data.custom_amount %}disabled{% endif %}>
                        <span class="preset-option-label">
                            <span>{{ preset }}</span>
                            <span class="preset-option-currency">{{ donation_currency_symbol }}</span>
                        </span>
                    </button>
                    {% endfor %}
                </div>

                <div class="custom-amount-wrap">
                    <div class="custom-amount-shell{% if form_data.custom_amount %} has-value{% endif %}"
                        id="custom-amount-shell">
                        <label class="sr-only" for="custom_amount">Other amount in lari</label>
                        <span class="custom-amount-sizer" id="custom-amount-sizer" aria-hidden="true"></span>
                        <input id="custom_amount" name="custom_amount" class="custom-amount-field" type="text"
                            inputmode="decimal" autocomplete="off" value="{{ form_data.custom_amount }}"
                            pattern="\d+(?:[\.,]\d{1,2})?" maxlength="10"
                            title="Enter a positive amount with up to 2 decimal places"
                            placeholder="other amount &lowbar;">
                        <span class="custom-amount-suffix" aria-hidden="true">{{ donation_currency_symbol }}</span>
                    </div>
                </div>

                <button type="submit" class="donation-submit"><span class="donation-submit-label">Donate</span></button>
            </form>
        </div>
    </div>

    <script>
        const DONATION_MIN_AMOUNT = {{ donation_min_amount | tojson }};
        const DONATION_MAX_AMOUNT = {{ donation_max_amount | tojson }};

        const donationForm = document.querySelector(".donation-form");
        const presetInput = document.getElementById("preset_amount");
        const customAmountInput = document.getElementById("custom_amount");
        const customAmountShell = document.getElementById("custom-amount-shell");
        const customAmountSizer = document.getElementById("custom-amount-sizer");
        const presetButtons = Array.from(document.querySelectorAll(".preset-option"));
        const submitButton = document.querySelector(".donation-submit");
        const jsErrorContainer = document.getElementById("donation-js-error");
        let isSubmitting = false;

        function showJsError(message) {
            jsErrorContainer.textContent = message;
            jsErrorContainer.hidden = false;
        }

        function clearJsError() {
            jsErrorContainer.hidden = true;
            jsErrorContainer.textContent = "";
        }

        function formatAmount(n) {
            return n % 1 === 0 ? String(n) : n.toFixed(2).replace(/\.?0+$/, "");
        }

        function resizeCustomAmountField() {
            customAmountSizer.textContent = customAmountInput.value || customAmountInput.placeholder;
            const measuredWidth = Math.ceil(customAmountSizer.getBoundingClientRect().width) + 8;
            const clampedWidth = Math.min(Math.max(measuredWidth, 96), window.innerWidth <= 700 ? 280 : 320);
            customAmountInput.style.width = `${clampedWidth}px`;
        }

        function updatePresetSelection(selectedAmount) {
            presetButtons.forEach((button) => {
                const isSelected = button.dataset.amount === selectedAmount;
                button.classList.toggle("is-selected", isSelected);
                button.setAttribute("aria-pressed", isSelected ? "true" : "false");
            });
        }

        function updatePresetAvailability(isInactive) {
            presetButtons.forEach((button) => {
                if (isInactive && document.activeElement === button) {
                    customAmountInput.focus();
                }
                button.disabled = isInactive;
                button.classList.toggle("is-inactive", isInactive);
            });
        }

        function updateCustomAmountState() {
            const hasValue = customAmountInput.value.trim() !== "";
            customAmountShell.classList.toggle("has-value", hasValue);
            if (hasValue) {
                presetInput.value = "";
                updatePresetSelection("");
            }
            updatePresetAvailability(hasValue);
            resizeCustomAmountField();
        }

        presetButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const amount = button.dataset.amount;
                presetInput.value = amount;
                customAmountInput.value = "";
                customAmountShell.classList.remove("has-value");
                updatePresetSelection(amount);
                resizeCustomAmountField();
            });
        });

        donationForm.addEventListener("submit", (event) => {
            clearJsError();

            const customRaw = customAmountInput.value.trim();
            const presetRaw = presetInput.value.trim();
            const raw = customRaw || presetRaw;

            if (!raw) {
                event.preventDefault();
                showJsError("Select a donation amount or enter another amount.");
                return;
            }

            const amount = parseFloat(raw.replace(",", "."));
            if (isNaN(amount) || amount <= 0) {
                event.preventDefault();
                showJsError("Enter a valid donation amount.");
                return;
            }

            if (amount < DONATION_MIN_AMOUNT) {
                event.preventDefault();
                showJsError(`Donation amount must be at least ${formatAmount(DONATION_MIN_AMOUNT)} {{ donation_currency_symbol }}.`);
                return;
            }

            if (amount > DONATION_MAX_AMOUNT) {
                event.preventDefault();
                showJsError(`Donation amount must be at most ${formatAmount(DONATION_MAX_AMOUNT)} {{ donation_currency_symbol }}.`);
                return;
            }

            if (isSubmitting) {
                event.preventDefault();
                return;
            }

            isSubmitting = true;
            donationForm.setAttribute("aria-busy", "true");
            submitButton.disabled = true;
            submitButton.classList.add("is-loading");
        });

        customAmountInput.addEventListener("input", updateCustomAmountState);
        window.addEventListener("resize", resizeCustomAmountField);
        updatePresetSelection(presetInput.value);
        updateCustomAmountState();
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(resizeCustomAmountField);
        }
    </script>
</body>

</html>