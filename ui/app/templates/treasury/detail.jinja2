{% extends "base.jinja2" %}
{% from 'transaction/macro_list.jinja2' import transaction_list with context %}
{% from 'widgets/pagination.jinja2' import pagination_control %}
{% from 'widgets/treasury_inline.jinja2' import treasury_inline %}
{% from 'widgets/history_stats.jinja2' import history_stats, stats_loader with context %}

{% block title %}Treasury{% endblock %}
{% block heading %}{% endblock %}

{% block content %}
<div class="treasury-dashboard">
    <div class="treasury-top-grid">
        <section class="treasury-hero-card">
            <div class="treasury-identity-row">
                <span class="treasury-type-badge" aria-hidden="true">Treasury</span>
                <h2 class="treasury-hero-title">{{ treasury_inline(treasury) }}</h2>
            </div>
            {% if treasury.comment %}
            <p class="treasury-comment">{{ treasury.comment }}</p>
            {% endif %}
            <div class="treasury-hero-footer">
                <p class="treasury-kicker">
                    Created {{ human_readable_date(treasury.created_at) }}
                    {% if treasury.modified_at %}
                    <span class="treasury-kicker-dot">•</span>
                    Modified {{ human_readable_date(treasury.modified_at) }}
                    {% endif %}
                </p>
                <div class="treasury-hero-actions">
                    <a href="{{ url_for('treasury.edit', id=treasury.id) }}"
                        class="big-button big-button-inline big-button-outline">Edit</a>
                    <a href="{{ url_for('treasury.delete', id=treasury.id) }}"
                        class="big-button big-button-inline big-button-outline">Delete</a>
                </div>
            </div>
        </section>

        <section class="treasury-card treasury-balance-card">
            <h3 class="treasury-card-title">Balance</h3>
            {% if not balance.draft and not balance.completed %}
            <p class="treasury-empty-state">No transactions yet.</p>
            {% endif %}

            {% if balance.completed %}
            <div class="treasury-balance-list">
                {% for currency, amount in balance.completed.items() %}
                {% if amount|float != 0 %}
                <div class="treasury-balance-row">
                    <strong class="treasury-balance-amount {% if amount|float < 0 %}amount-negative{% endif %}">{{
                        amount }}</strong>
                    <span class="treasury-balance-currency">{{ currency | upper }}</span>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            {% if balance.draft %}
            <div class="treasury-balance-separator">Draft</div>
            <div class="treasury-balance-list">
                {% for currency, amount in balance.draft.items() %}
                {% if amount|float != 0 %}
                <div class="treasury-balance-row treasury-balance-row-draft">
                    <strong class="treasury-balance-amount {% if amount|float < 0 %}amount-negative{% endif %}">{{
                        amount }}</strong>
                    <span class="treasury-balance-currency">{{ currency | upper }}</span>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}
        </section>
    </div>

    <section class="treasury-card treasury-list-card">
        <div class="treasury-card-header">
            <h3 class="treasury-card-title">Transactions</h3>
            <span class="treasury-chip">{{ total }} total</span>
        </div>
        {% if transactions %}
        {{ transaction_list(transactions) }}
        {{ pagination_control(page, total, limit) }}
        {% else %}
        <p class="treasury-empty-state">No transactions for this treasury yet.</p>
        {% endif %}
    </section>

    <section class="treasury-card entity-stats-card">
        <div class="treasury-card-header">
            <h3 class="treasury-card-title">Statistics</h3>
        </div>
        {% if not stats_loaded %}
        {{ stats_loader(
            url_for('treasury.stats', id=treasury.id, stats_months=stats_months),
            'treasury'
        ) }}
        {% else %}
        {% call history_stats(balance_changes, money_flow_by_day, stats_months, 'treasury-history') %}{% endcall %}
        {% endif %}
    </section>
</div>
{% endblock %}
