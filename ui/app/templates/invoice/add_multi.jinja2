{% extends 'base.jinja2' %}
{% from 'widgets/entity_selector.jinja2' import entity_selector %}
{% from 'widgets/tag_selector.jinja2' import tag_selector %}

{% block title %}New Multi-Recipient Invoice{% endblock %}

{% block content %}
<div class="invoice-form-layout shortcut-form-container">
    <section class="entry-form-card">
        <form method="post" class="entry-form" id="multi-invoice-form">
            {{ form.hidden_tag() }}

            <div class="form-group">
                <label class="form-label">From</label>
                {{ entity_selector('from_entity', show_id_input=False) }}
            </div>

            <div class="form-group">
                <label class="form-label" for="comment">Comment</label>
                {{ form.comment(class_='form-input') }}
            </div>

            <div class="form-group invoice-short-input">
                <label class="form-label" for="billing_period">Billing period</label>
                {{ form.billing_period(class_='form-input') }}
            </div>

            <h2 style="margin: 1.5rem 0 0.5rem">Recipients</h2>

            {% for n in range(max_items) %}
            <div class="invoice-multi-item-slot" id="item-slot-{{ n }}" {% if n> 0 %} style="display:none"{% endif %}>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;">
                    <strong>Recipient {{ n + 1 }}</strong>
                    {% if n > 0 %}
                    <button type="button" class="btn-link" onclick="hideItemSlot({{ n }})">Remove</button>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label class="form-label">
                        To entity
                        <span class="secondary" style="font-weight:normal">(optional — can be chosen at pay time)</span>
                    </label>
                    {{ entity_selector('item_' ~ n ~ '_to_entity', show_id_input=False) }}
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Tag filter
                        <span class="secondary" style="font-weight:normal">(optional — entity must have this tag at pay
                            time)</span>
                    </label>
                    <select name="item_{{ n }}_to_tag_id" class="form-input">
                        <option value="">— any entity —</option>
                        {% for tag in all_tags | sort(attribute='name') %}
                        <option value="{{ tag.id }}">{{ tag.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-row transaction-equal-row">
                    <div class="form-field form-field-amount">
                        <label class="form-label">Amount 1</label>
                        <input type="number" name="item_{{ n }}_amount_1" class="form-input" step="0.01" min="0.01"
                            placeholder="10.00" required>
                    </div>
                    <div class="form-field form-field-currency">
                        <label class="form-label">Currency 1</label>
                        <select name="item_{{ n }}_currency_1" class="form-input">
                            {% for value, label in currency_choices %}
                            <option value="{{ value }}" {% if value==preferred_currency %} selected{% endif %}>{{ label
                                }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="form-row transaction-equal-row">
                    <div class="form-field form-field-amount">
                        <label class="form-label">Amount 2 <span class="secondary">optional</span></label>
                        <input type="number" name="item_{{ n }}_amount_2" class="form-input" step="0.01" min="0.01"
                            placeholder="27.00">
                    </div>
                    <div class="form-field form-field-currency">
                        <label class="form-label">Currency 2</label>
                        <select name="item_{{ n }}_currency_2" class="form-input">
                            {% for value, label in currency_choices %}
                            <option value="{{ value }}" {% if value==preferred_currency %} selected{% endif %}>{{ label
                                }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="form-row transaction-equal-row" style="margin-bottom:1rem">
                    <div class="form-field form-field-amount">
                        <label class="form-label">Amount 3 <span class="secondary">optional</span></label>
                        <input type="number" name="item_{{ n }}_amount_3" class="form-input" step="0.01" min="0.01"
                            placeholder="5.00">
                    </div>
                    <div class="form-field form-field-currency">
                        <label class="form-label">Currency 3</label>
                        <select name="item_{{ n }}_currency_3" class="form-input">
                            {% for value, label in currency_choices %}
                            <option value="{{ value }}" {% if value==preferred_currency %} selected{% endif %}>{{ label
                                }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
            {% endfor %}

            <div id="add-item-btn-wrap" style="margin-bottom:1.5rem">
                <button type="button" class="big-button big-button-outline" onclick="addNextItemSlot()">+ Add
                    recipient</button>
            </div>

            <div class="form-group">
                <label class="form-label">Tags</label>
                {{ tag_selector('tag_ids', all_tags, []) }}
            </div>

            <div class="form-actions">
                {{ form.submit(class_='big-button', value='Create Invoice') }}
            </div>
        </form>
    </section>

    <p class="secondary" style="text-align:center;margin-top:1rem">
        <a href="{{ url_for('invoice.add') }}">← Simple invoice</a>
    </p>
</div>

<script src="/static/js/entitySelector.js"></script>
<script src="/static/js/multiSelect.js"></script>
<script>
(function () {
    var maxItems = {{ max_items }};
    var visible = [0];

    function slotAmountInputs(slot) {
        return slot.querySelectorAll('input[type="number"]');
    }

    function stripRequired(slot) {
        slotAmountInputs(slot).forEach(function (el) { el.removeAttribute('required'); });
    }

    function restoreRequired(slot) {
        // only the first amount field per slot is required
        var first = slot.querySelector('input[name$="_amount_1"]');
        if (first) first.setAttribute('required', '');
    }

    // Strip required from slots that start hidden
    for (var i = 1; i < maxItems; i++) {
        var s = document.getElementById('item-slot-' + i);
        if (s) stripRequired(s);
    }

    window.hideItemSlot = function (n) {
        var slot = document.getElementById('item-slot-' + n);
        if (!slot) return;
        slot.style.display = 'none';
        visible = visible.filter(function (i) { return i !== n; });
        stripRequired(slot);
        // clear inputs so the slot doesn't accidentally contribute
        slot.querySelectorAll('input[type="number"]').forEach(function (el) { el.value = ''; });
        slot.querySelectorAll('input[type="hidden"]').forEach(function (el) { el.value = ''; });
        slot.querySelectorAll('input[type="search"]').forEach(function (el) { el.value = ''; });
        slot.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });
        updateAddBtn();
    };

    window.addNextItemSlot = function () {
        for (var i = 0; i < maxItems; i++) {
            if (visible.indexOf(i) === -1) {
                var slot = document.getElementById('item-slot-' + i);
                if (slot) {
                    slot.style.display = '';
                    restoreRequired(slot);
                    visible.push(i);
                    slot.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    updateAddBtn();
                }
                break;
            }
        }
    };

    function updateAddBtn() {
        var wrap = document.getElementById('add-item-btn-wrap');
        if (wrap) wrap.style.display = visible.length >= maxItems ? 'none' : '';
    }


}());
</script>
{% endblock %}