{% extends "base.jinja2" %}

{% from 'widgets/tag_inline.jinja2' import tag_inline %}

{% block title %}Fee{% endblock %}
{% block content %}
{% set month_names = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] %}
{% set group_titles = {
"resident": "Residents",
"member": "Members",
"ex-resident": "Ex-residents",
"ex-member": "Ex-members",
"other": "Other"
} %}
{% set month_count = fees[0].fees|length if fees else 0 %}
{% set total_columns = 2 + month_count %}
{% set collapsed_groups = ["ex-resident", "ex-member"] %}
<div class="fee-table-wrap">
    <table class="fee-table">
        <tbody>
            {% set state = namespace(prev_group=None) %}
            {% for row in fee_rows %}
            {% set monthly_fee = row.fee %}
            {% set is_last = loop.last %}
            {% set next_group = fee_rows[loop.index].group if not loop.last else None %}
            {% if state.prev_group is not none and state.prev_group != row.group %}
            {% if state.prev_group in group_unpaid_totals %}
            <tr class="fee-group-total-row{% if state.prev_group in collapsed_groups %} fee-spoiler-row{% endif %}"
                {% if state.prev_group in collapsed_groups %}data-fee-group="{{ state.prev_group }}" hidden{% endif %}>
                <td></td>
                <td class="fee-group-total-label">
                    Total unpaid:
                    <span class="fee-unpaid-total">
                        {% set gt = group_unpaid_totals[state.prev_group] %}
                        {% set dc = 'usd' if 'usd' in gt else gt.keys()|first %}
                        {{ "%.2f"|format(gt[dc]|float) }} {{ dc | upper }}
                    </span>
                </td>
                <td colspan="{{ month_count }}"></td>
            </tr>
            {% endif %}
            <tr class="fee-category-gap-row" aria-hidden="true">
                <td class="fee-category-gap" colspan="{{ total_columns }}"></td>
            </tr>
            {% endif %}
            {% if state.prev_group != row.group %}
            <tr class="fee-category-row fee-category-row--{{ row.group }}">
                <td colspan="{{ total_columns }}">
                    <h2 class="fee-category-title">
                        {% if row.group in collapsed_groups %}
                        <button type="button" class="fee-spoiler-toggle" data-fee-group="{{ row.group }}"
                            aria-expanded="false">
                            <span class="fee-spoiler-icon" aria-hidden="true">▶</span>
                            {{ group_titles.get(row.group, row.group|capitalize) }}
                        </button>
                        {% else %}
                        {{ group_titles.get(row.group, row.group|capitalize) }}
                        {% endif %}
                    </h2>
                </td>
            </tr>
            <tr class="fee-category-arrow fee-category-arrow--{{ row.group }}{% if row.group in collapsed_groups %} fee-spoiler-row{% endif %}"
                {% if row.group in collapsed_groups %}data-fee-group="{{ row.group }}" hidden{% endif %}>
                <th></th>
                <th></th>
                {% if fees %}
                {% for month in fees[0].fees|reverse %}
                {% if month.month==current_month and month.year==current_year %}
                <th class="center-align">▼</th>
                {% else %}
                <th></th>
                {% endif %}
                {% endfor %}
                {% endif %}
            </tr>
            <tr class="fee-category-header fee-category-header--{{ row.group }}{% if row.group in collapsed_groups %} fee-spoiler-row{% endif %}"
                {% if row.group in collapsed_groups %}data-fee-group="{{ row.group }}" hidden{% endif %}>
                <th>#</th>
                <th>Entity</th>
                {% if fees %}
                {% for month in fees[0].fees|reverse %}
                <th
                    class="center-align {% if month.month==current_month and month.year==current_year %}fee-current-month{% endif %}">
                    {{ month_names[month.month] }} {{ month.year }}
                </th>
                {% endfor %}
                {% endif %}
            </tr>
            {% endif %}
            <tr class="fee-row fee-row--{{ row.group }}{% if row.group in collapsed_groups %} fee-spoiler-row{% endif %}"
                {% if row.group in collapsed_groups %}data-fee-group="{{ row.group }}" hidden{% endif %}>
                <td class="fee-index fee-index--{{ row.group }}">{{ row.index + 1 }}</td>
                <td class="fee-entity-cell">
                    <a href="{{ url_for('entity.detail', id=monthly_fee.entity.id) }}"
                        class="fee-entity-name {% if not monthly_fee.entity.active %}secondary inactive{% endif %}">{{monthly_fee.entity.name}}</a>
                    {% for tag in monthly_fee.entity.tags %}
                    {{ tag_inline(tag) }}
                    {% endfor %}
                    {% if row.unpaid_total %}
                    <span class="fee-unpaid-total">
                        {% set dc = 'usd' if 'usd' in row.unpaid_total else row.unpaid_total.keys()|first %}
                        {{ "%.2f"|format(row.unpaid_total[dc]|float) }} {{ dc | upper }}
                    </span>
                    {% endif %}
                </td>

                {% for fee in monthly_fee.fees|reverse %}
                {% set is_future = fee.year > current_year or (fee.year == current_year and fee.month > current_month)
                %}
                {% if fee.amounts %}
                {% set display_currency = 'usd' if 'usd' in fee.amounts else fee.amounts.keys()|first %}
                <td class="fee-cell fee-cell--paid">
                    {% if fee.paid_invoice_id %}
                    <a class="fee-cell-link fee-cell-link--paid"
                        href="{{ url_for('invoice.detail', id=fee.paid_invoice_id) }}"
                        title="Paid invoice {{ fee.paid_invoice_id }}">
                        💰{{ "%.2f"|format(fee.amounts[display_currency]|float) }} {{ display_currency | upper }}
                    </a>
                    {% else %}
                    💰{{ "%.2f"|format(fee.amounts[display_currency]|float) }} {{ display_currency | upper }}
                    {% endif %}
                </td>
                {% elif fee.unpaid_invoice_id %}
                <td class="fee-cell fee-cell--unpaid">
                    <a class="fee-cell-link fee-cell-link--unpaid"
                        href="{{ url_for('invoice.detail', id=fee.unpaid_invoice_id) }}"
                        title="Unpaid invoice {{ fee.unpaid_invoice_id }}">
                        {% if fee.unpaid_invoice_amounts and fee.unpaid_invoice_amounts.get('usd') is not none %}
                        ❌{{ "%.2f"|format(fee.unpaid_invoice_amounts.get('usd')|float) }} USD
                        {% else %}
                        ❌invoice
                        {% endif %}
                    </a>
                </td>
                {% else %}
                <td class="fee-cell">
                </td>
                {% endif %}
                {% endfor %}
            </tr>
            {% if is_last or next_group != row.group %}
            {% if row.group in group_unpaid_totals and is_last %}
            <tr class="fee-group-total-row{% if row.group in collapsed_groups %} fee-spoiler-row{% endif %}"
                {% if row.group in collapsed_groups %}data-fee-group="{{ row.group }}" hidden{% endif %}>
                <td></td>
                <td class="fee-group-total-label">
                    Total unpaid:
                    <span class="fee-unpaid-total">
                        {% set gt = group_unpaid_totals[row.group] %}
                        {% set dc = 'usd' if 'usd' in gt else gt.keys()|first %}
                        {{ "%.2f"|format(gt[dc]|float) }} {{ dc | upper }}
                    </span>
                </td>
                <td colspan="{{ month_count }}"></td>
            </tr>
            {% endif %}
            {% endif %}
            {% set state.prev_group = row.group %}
            {% endfor %}
        </tbody>
    </table>
</div>
<script>
    document.querySelectorAll('.fee-spoiler-toggle').forEach((toggle) => {
        toggle.addEventListener('click', () => {
            const group = toggle.dataset.feeGroup;
            const expanded = toggle.getAttribute('aria-expanded') !== 'true';

            document.querySelectorAll('.fee-spoiler-row').forEach((row) => {
                if (row.dataset.feeGroup === group) {
                    row.hidden = !expanded;
                }
            });

            toggle.setAttribute('aria-expanded', String(expanded));
            toggle.querySelector('.fee-spoiler-icon').textContent = expanded ? '▼' : '▶';
        });
    });
</script>
{% endblock %}
