{% extends "base.jinja2" %}

{% block title %}Stats{% endblock title %}

{% block content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>

<style>
    .charts {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-around;
    }

    .chart-container {
        flex: 1 1 45%;
        max-width: 45%;
        padding: 10px;
        box-sizing: border-box;
    }

    .chart-container canvas {
        width: 100% !important;
        height: auto !important;
    }

    .chart-container-wide {
        flex: 1 1 100%;
        max-width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    .chart-empty-message {
        margin-top: 12px;
        text-align: center;
        color: #6b7280;
        font-style: italic;
    }

    /* Responsive: full width on small screens */
    @media (max-width: 600px) {
        .chart-container {
            flex: 1 1 100%;
            max-width: 100%;
        }
    }
</style>

<div class="charts">
    <div class="chart-container-wide">
        <h2>Resident Fee Sum by Month</h2>
        <div id="resident-fee-chart" style="width:100%;height:600px;"></div>
    </div>
    <div class="chart-container">
        <h2>Transactions Sum by Week</h2>
        <canvas id="transactions-week-chart"></canvas>
    </div>
</div>

<script>
    // --- 3D Waterfall Resident Fee Chart (Plotly) ---
    const accumulationData = {{ resident_fee_accumulation | tojson }};
    const totalMonths = accumulationData.length;

    if (totalMonths > 0) {
        const traces = [];

        accumulationData.forEach((item, idx) => {
            const label = `${item.year}-${item.month.toString().padStart(2, '0')}`;
            const days = item.daily_cumulative.map(d => d.day);
            const zVals = item.daily_cumulative.map(d => d.cumulative_usd);
            const yVals = days.map(() => idx);

            // Color: hue spread across months, newest = brightest
            const hue = Math.round((idx / totalMonths) * 300);
            const color = `hsl(${hue}, 70%, 50%)`;

            // Filled area: line on top, floor at 0
            traces.push({
                type: 'scatter3d',
                mode: 'lines',
                x: days,
                y: yVals,
                z: zVals,
                line: { color: color, width: 4 },
                name: label,
                showlegend: true,
                hovertemplate: `${label}<br>Day %{x}<br>$%{z:.0f}<extra></extra>`,
            });

            // Vertical "curtain" fill beneath each line
            const xFill = [];
            const yFill = [];
            const zFill = [];
            for (let i = 0; i < days.length; i++) {
                xFill.push(days[i], days[i], days[i]);
                yFill.push(idx, idx, idx);
                zFill.push(0, zVals[i], null);
            }
            traces.push({
                type: 'scatter3d',
                mode: 'lines',
                x: xFill,
                y: yFill,
                z: zFill,
                line: { color: color, width: 1 },
                opacity: 0.15,
                showlegend: false,
                hoverinfo: 'skip',
            });
        });

        // Expected and expenses planes for the latest month
        const latest = accumulationData[totalMonths - 1];
        const maxDay = latest.daily_cumulative.length;

        if (latest.expected_total_usd > 0) {
            traces.push({
                type: 'scatter3d',
                mode: 'lines',
                x: [1, maxDay],
                y: [totalMonths - 1, totalMonths - 1],
                z: [latest.expected_total_usd, latest.expected_total_usd],
                line: { color: 'rgb(255, 99, 132)', width: 3, dash: 'dash' },
                name: 'Expected (latest)',
            });
        }
        if (latest.expenses_usd > 0) {
            traces.push({
                type: 'scatter3d',
                mode: 'lines',
                x: [1, maxDay],
                y: [totalMonths - 1, totalMonths - 1],
                z: [latest.expenses_usd, latest.expenses_usd],
                line: { color: 'rgb(255, 159, 64)', width: 3, dash: 'dash' },
                name: 'Expenses (latest)',
            });
        }

        const monthLabels = accumulationData.map(
            (item, idx) => [idx, `${item.year}-${item.month.toString().padStart(2, '0')}`]
        );

        Plotly.newPlot('resident-fee-chart', traces, {
            scene: {
                xaxis: { title: 'Day of Month', dtick: 1 },
                yaxis: {
                    title: 'Month',
                    tickvals: monthLabels.map(m => m[0]),
                    ticktext: monthLabels.map(m => m[1]),
                },
                zaxis: { title: 'Cumulative Paid Fees (USD)' },
                camera: {
                    eye: { x: 1.8, y: -1.8, z: 0.8 },
                },
            },
            margin: { l: 0, r: 0, t: 30, b: 0 },
            legend: { x: 0, y: 1 },
        }, { responsive: true });
    }

    const transactionsData = {{ transactions_sum_by_week | tojson }};
    const transactionsLabels = transactionsData.map(item => `${item.year}-W${item.week.toString().padStart(2, '0')}`);
    const transactionsDatasets = {};

    transactionsData.forEach(item => {
        for (const currency in item.amounts) {
            if (!transactionsDatasets[currency]) {
                transactionsDatasets[currency] = {
                    label: currency,
                    data: [],
                    borderWidth: 1,
                    type: 'bar'
                };
            }
        }
    });

    transactionsDatasets['total_usd'] = {
        label: 'total_usd',
        data: [],
        borderWidth: 2,
        type: 'line',
        tension: 0.2,
        yAxisID: 'y'
    };

    transactionsData.forEach(item => {
        for (const key in transactionsDatasets) {
            if (key === 'total_usd') continue;
            transactionsDatasets[key].data.push(item.amounts[key] || 0);
        }
        transactionsDatasets['total_usd'].data.push(item.total_usd || 0);
    });

    new Chart(document.getElementById('transactions-week-chart'), {
        type: 'bar',
        data: {
            labels: transactionsLabels,
            datasets: Object.values(transactionsDatasets)
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

{% endblock content %}