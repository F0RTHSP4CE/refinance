{% extends "base.jinja2" %}

{% block title %}Stats{% endblock title %}

{% block content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .charts {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-around;
    }

    .chart-container {
        flex: 1 1 45%;
        max-width: 45%;
        padding: 10px;
        box-sizing: border-box;
    }

    .chart-container canvas {
        width: 100% !important;
        height: auto !important;
    }

    .chart-empty-message {
        margin-top: 12px;
        text-align: center;
        color: #6b7280;
        font-style: italic;
    }

    /* Responsive: full width on small screens */
    @media (max-width: 600px) {
        .chart-container {
            flex: 1 1 100%;
            max-width: 100%;
        }
    }
</style>

<div class="charts">
    <div class="chart-container">
        <h2>Fee Transactions</h2>
        <canvas id="fee-month-chart"></canvas>
    </div>
    <div class="chart-container">
        <h2>Monthly Fee Sum</h2>
        <canvas id="monthly-fee-chart"></canvas>
    </div>
    <div class="chart-container">
        <h2>Donations</h2>
        <canvas id="donations-month-chart"></canvas>
    </div>
    <div class="chart-container">
        <h2>Treasury Funds vs Entity Balances</h2>
        <canvas id="system-balance-chart"></canvas>
    </div>
</div>

<script>
    const systemBalanceData = {{ system_balance_history | tojson }};
    const formatUSD = (value) => `$${Number(value || 0).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
    })}`;
    new Chart(document.getElementById('system-balance-chart'), {
        type: 'line',
        data: {
            labels: systemBalanceData.map(item => item.day.slice(0, 7)),
            datasets: [
                {
                    label: 'Real treasury funds (USD)',
                    data: systemBalanceData.map(item => item.real_funds_usd || 0),
                    borderColor: 'rgb(34, 197, 94)',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    borderWidth: 3,
                    pointRadius: 3,
                    tension: 0.15,
                },
                {
                    label: 'Positive entity balances (USD)',
                    data: systemBalanceData.map(item => item.positive_entity_balances_usd || 0),
                    borderColor: 'rgb(59, 130, 246)',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 3,
                    pointRadius: 3,
                    tension: 0.15,
                },
                {
                    label: 'Deficit (USD)',
                    data: systemBalanceData.map(item => item.deficit_usd || 0),
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    borderWidth: 2,
                    pointRadius: 3,
                    tension: 0.15,
                    fill: true,
                },
            ],
        },
        options: {
            interaction: { mode: 'index', intersect: false },
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: 'USD' },
                    ticks: { callback: value => formatUSD(value) },
                },
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: context => `${context.dataset.label}: ${formatUSD(context.parsed.y)}`,
                    },
                },
            },
        },
    });

    const monthlyFeeData = {{ monthly_fee_sum | tojson }};

    const monthlyFeeLabels = monthlyFeeData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    // Paid total USD (bars)
    const paidData = monthlyFeeData.map(item => item.total_usd || 0);

    // Expected total USD (target caps)
    const expectedData = monthlyFeeData.map(item => item.expected_total_usd || 0);

    new Chart(document.getElementById('monthly-fee-chart'), {
        type: 'bar',
        data: {
            labels: monthlyFeeLabels,
            datasets: [
                {
                    label: 'Paid Fees (USD)',
                    data: paidData,
                    borderWidth: 2,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.65)',
                    barPercentage: 0.45,
                    categoryPercentage: 0.8,
                    maxBarThickness: 24
                },
                {
                    type: 'line',
                    label: 'Expected Fees (USD)',
                    data: expectedData,
                    borderColor: 'rgb(255, 159, 64)',
                    backgroundColor: 'rgb(255, 159, 64)',
                    showLine: false,
                    pointStyle: 'line',
                    pointRadius: 14,
                    pointHoverRadius: 16,
                    pointBorderWidth: 4
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Amount (USD)'
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });

    const feeMonthData = {{ fee_transactions_by_month | tojson }};
    const feeMonthLabels = feeMonthData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    new Chart(document.getElementById('fee-month-chart'), {
        type: 'line',
        data: {
            labels: feeMonthLabels,
            datasets: [
                {
                    label: 'Fees to F0 (USD)',
                    data: feeMonthData.map(item => item.f0_fee_total_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    tension: 0.2,
                    fill: true
                },
                {
                    label: 'Fees to rooms (USD)',
                    data: feeMonthData.map(item => item.room_fee_total_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(59, 130, 246)',
                    backgroundColor: 'rgba(59, 130, 246, 0.05)',
                    tension: 0.2,
                    fill: false
                },
                {
                    label: 'F0 Expenses: rent + utilities (USD)',
                    data: feeMonthData.map(item => item.expenses_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(255, 159, 64)',
                    backgroundColor: 'rgba(255, 159, 64, 0.05)',
                    tension: 0.2,
                    fill: false
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    const donationsMonthData = {{ donations_by_month | tojson }};
    const donationsMonthLabels = donationsMonthData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    new Chart(document.getElementById('donations-month-chart'), {
        type: 'line',
        data: {
            labels: donationsMonthLabels,
            datasets: [
                {
                    label: 'Donations to F0 (USD)',
                    data: donationsMonthData.map(item => item.f0_donation_total_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(34, 197, 94)',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    tension: 0.2,
                    fill: true
                },
                {
                    label: 'General donation-tagged transactions (USD)',
                    data: donationsMonthData.map(item => item.general_donation_total_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(59, 130, 246)',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    tension: 0.2,
                    fill: false
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

{% endblock content %}
