{% extends "base.jinja2" %}

{% block title %}Stats{% endblock title %}

{% block content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .charts {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-around;
    }

    .chart-container {
        flex: 1 1 45%;
        max-width: 45%;
        padding: 10px;
        box-sizing: border-box;
    }

    .chart-container canvas {
        width: 100% !important;
        height: auto !important;
    }

    .chart-empty-message {
        margin-top: 12px;
        text-align: center;
        color: #6b7280;
        font-style: italic;
    }

    /* Responsive: full width on small screens */
    @media (max-width: 600px) {
        .chart-container {
            flex: 1 1 100%;
            max-width: 100%;
        }
    }
</style>

<div class="charts">
    <div class="chart-container">
        <h2>Resident Fee Sum by Month</h2>
        <canvas id="resident-fee-chart"></canvas>
    </div>
    <div class="chart-container">
        <h2>Resident Fee per Invoice</h2>
        <canvas id="resident-fee-average-chart"></canvas>
    </div>
    <div class="chart-container">
        <h2>Fee Transactions per Month</h2>
        <canvas id="fee-month-chart"></canvas>
    </div>
</div>

<script>
    const residentFeeData = {{ resident_fee_sum | tojson }};

    const residentFeeLabels = residentFeeData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    // Paid total USD (solid line)
    const paidData = residentFeeData.map(item => item.total_usd || 0);

    // Expected total USD (dashed line - ceiling)
    const expectedData = residentFeeData.map(item => item.expected_total_usd || 0);

    // F0 expenses: rent + utilities (dashed line)
    const expensesData = residentFeeData.map(item => item.expenses_usd || 0);

    new Chart(document.getElementById('resident-fee-chart'), {
        type: 'line',
        data: {
            labels: residentFeeLabels,
            datasets: [
                {
                    label: 'Paid Fees (USD)',
                    data: paidData,
                    borderWidth: 3,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.2,
                    fill: true
                },
                {
                    label: 'Expected Fees (USD)',
                    data: expectedData,
                    borderWidth: 2,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.05)',
                    borderDash: [5, 5],
                    tension: 0.2,
                    fill: false
                },
                {
                    label: 'F0 Expenses: rent + utilities (USD)',
                    data: expensesData,
                    borderWidth: 2,
                    borderColor: 'rgb(255, 159, 64)',
                    backgroundColor: 'rgba(255, 159, 64, 0.05)',
                    tension: 0.2,
                    fill: false
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Amount (USD)'
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });

    const residentFeeAverageData = {{ resident_fee_average | tojson }};
    const residentFeeAverageLabels = residentFeeAverageData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    new Chart(document.getElementById('resident-fee-average-chart'), {
        type: 'line',
        data: {
            labels: residentFeeAverageLabels,
            datasets: [
                {
                    label: 'Paid Fees / Invoice Issued (USD)',
                    data: residentFeeAverageData.map(item => item.paid_usd_per_invoice || 0),
                    borderWidth: 3,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.2,
                    fill: true
                },
                {
                    label: 'Expected Fees / Invoice Issued (USD)',
                    data: residentFeeAverageData.map(item => item.expected_usd_per_invoice || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.05)',
                    borderDash: [5, 5],
                    tension: 0.2,
                    fill: false
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Amount per invoice (USD)'
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });

    const feeMonthData = {{ fee_transactions_by_month | tojson }};
    const feeMonthLabels = feeMonthData.map(item => `${item.year}-${item.month.toString().padStart(2, '0')}`);

    new Chart(document.getElementById('fee-month-chart'), {
        type: 'line',
        data: {
            labels: feeMonthLabels,
            datasets: [
                {
                    label: 'Fees (USD)',
                    data: feeMonthData.map(item => item.fee_total_usd || 0),
                    borderWidth: 2,
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                    tension: 0.2,
                    fill: true
                }
            ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

{% endblock content %}
